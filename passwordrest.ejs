<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password | Royal Mist</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        :root { 
            --gold: #c4a14d; 
            --solid-black: #000000; 
        }

        body { 
            background-color: var(--solid-black) !important; 
            color: #fff; 
            font-family: 'Montserrat', sans-serif; 
            padding-top: 80px;
        }

        h2 { font-family: 'Playfair Display', serif; font-size: 2.2rem; margin-bottom: 10px; }
        
        .reset-wrapper { 
            max-width: 400px; 
            margin: 0 auto; 
            padding: 20px; 
        }

        label { 
            color: var(--gold); 
            font-size: 0.65rem; 
            letter-spacing: 3px; 
            text-transform: uppercase; 
            margin-bottom: 10px; 
            display: block; 
        }
        
        /* Consistent with Create Account theme */
        input { 
            background-color: var(--solid-black) !important; 
            border: 2px solid #222 !important; 
            color: #fff !important; 
            border-radius: 0 !important; 
            padding: 15px !important; 
            margin-bottom: 25px; 
        }

        input:focus { 
            border-color: var(--gold) !important; 
            box-shadow: none !important; 
        }
        
        .btn-reset { 
            background: var(--gold); 
            color: #000; 
            border: none; 
            width: 100%; 
            padding: 18px; 
            font-weight: 700; 
            text-transform: uppercase; 
            letter-spacing: 2px; 
        }

        .btn-reset:hover { background: #e2bd65; }
        
        .sub-text { color: #777; font-size: 0.85rem; margin-bottom: 40px; }
        a { color: var(--gold); text-decoration: none; font-size: 0.8rem; }
    </style>
</head>
<body>

<div class="container reset-wrapper">
    <h2 class="text-center">Reset Password</h2>
    <p class="text-center sub-text">Enter your new password below.</p>

    <form>
        <label>New Password</label>
        <input type="password" class="form-control" placeholder="••••••••">

        <label>Confirm Password</label>
        <input type="password" class="form-control" placeholder="••••••••">

        <button type="submit" class="btn-reset">UPDATE PASSWORD →</button>
    </form>

    <div class="text-center mt-4">
        <a href="#">← Back to Sign In</a>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>