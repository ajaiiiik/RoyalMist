<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password | Royal Mist</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        :root { --gold: #c4a14d; --dark-bg: #000000; }
        body { background-color: var(--dark-bg); color: #fff; font-family: 'Montserrat', sans-serif; }
        h2 { font-family: 'Playfair Display', serif; }
        
        .forgot-container { max-width: 400px; margin: 80px auto; padding: 20px; }
        label { color: var(--gold); font-size: 0.75rem; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 8px; display: block; }
        
        input { background: transparent !important; border: 1px solid #333 !important; color: #fff !important; border-radius: 0 !important; padding: 12px !important; margin-bottom: 20px; }
        input:focus { border-color: var(--gold) !important; box-shadow: none !important; }
        
        .btn-reset { background: var(--gold); color: #000; border: none; width: 100%; padding: 15px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; transition: 0.3s; }
        .btn-reset:hover { background: #e2bd65; }
        
        .back-link { color: var(--gold); text-decoration: none; font-size: 0.8rem; display: block; text-align: center; margin-top: 20px; }
        .info-text { color: #888; font-size: 0.85rem; margin-bottom: 30px; line-height: 1.6; }
    </style>
</head>

<body>
    <!-- Success Toast -->
<div id="successToast" style="
    display:none;
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: black;
    color:  #c4a14d;
    border: 2px solid #c4a14d;
    padding: 15px 25px;
    font-weight: 700;
    border-radius: 8px;
    font-family: 'Montserrat', sans-serif;
    z-index: 9999;
    align-items:center;
    gap:10px;
    box-shadow: 0 0 10px rgba(0,0,0,0.5);
">
    <span style="font-size:18px;">📩</span>
    <span id="successText">OTP Sent Successfully</span>
</div>

<div class="container forgot-container">
    <h2 class="text-center mb-2">Forgot Password</h2>
    <p class="text-center info-text">Enter your email address below, and we'll send you an OTP to reset your password.</p>

    <form>
        <label>Email Address</label>
        <input type="email" class="form-control" placeholder="vane@luxury.com" required>

        <button type="submit" class="btn-reset">Send OTP →</button>
    </form>

    <a href="/signin" class="back-link">← Back to Sign In</a>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
const form = document.querySelector("form");

form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const email = document.querySelector("input").value.trim();
    if (!email) {
    const toast = document.getElementById("successToast");
    const text = document.getElementById("successText");

    toast.style.borderColor = "red";
    toast.style.color = "red";
    text.innerText = "Email is required";
    toast.style.display = "flex";

    setTimeout(() => {
        toast.style.display = "none";
        toast.style.borderColor = "#c4a14d";
        toast.style.color = "#c4a14d";
    }, 2000);

    return;
}

    try {
        const res = await fetch("/forgot-password", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email }),
            credentials: "include"
        });

        const data = await res.json();

        if (data.success) {
            const toast = document.getElementById("successToast");
            const text = document.getElementById("successText");

            text.innerText = "OTP Sent! Redirecting...";
            toast.style.display = "flex";

            setTimeout(() => {
                toast.style.display = "none";
              window.location.href = "/otp?flow=forgot"; 
            }, 1500);

        } else {
            const toast = document.getElementById("successToast");
            const text = document.getElementById("successText");

            toast.style.borderColor = "red";
            toast.style.color = "red";
            text.innerText = data.errors?.email || "Error sending OTP";
            toast.style.display = "flex";

            setTimeout(() => {
                toast.style.display = "none";
                toast.style.borderColor = "#c4a14d";
                toast.style.color = "#c4a14d";
            }, 3000);
        }

    } catch (err) {
        console.log(err);
    }
});
</script>
</body>
</html>