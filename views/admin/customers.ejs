<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Customer Management — RoyalMist Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
:root {
  --gold: #c4a14d;
  --gold-light: #d4b05d;
  --bg: #000;
  --sidebar-bg: #050505;
  --card: #0a0a0a;
  --border: #1a1a1a;
  --border-dim: #111;
  --text: #fff;
  --text-muted: #888;
  --active-green: #2ecc71;
  --blocked-red: #e74c3c;
  --sidebar-width: 240px;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  background: var(--bg);
  color: var(--text);
  font-family: 'Playfair Display', serif;
  min-height: 100vh;
  display: flex;
}
.sidebar {
  width: var(--sidebar-width);
  background: var(--sidebar-bg);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  position: fixed;
  top: 0; left: 0;
  height: 100vh;
  z-index: 100;
  transition: transform 0.3s ease;
}
.sidebar-logo {
  padding: 28px 24px 24px;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  gap: 12px;
}
.logo-icon {
  width: 36px; height: 36px;
  background: var(--gold);
  display: flex; align-items: center; justify-content: center;
  font-size: 18px;
  clip-path: polygon(0 0, 70% 0, 100% 30%, 100% 100%, 30% 100%, 0 70%);
  flex-shrink: 0;
}
.logo-text { color: var(--gold); font-size: 13px; letter-spacing: 4px; font-weight: 700; }
.sidebar-nav { flex: 1; padding: 20px 0; overflow-y: auto; }
.nav-item {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 13px 24px;
  color: #666;
  text-decoration: none;
  font-size: 13px;
  letter-spacing: 1px;
  transition: all 0.2s;
  cursor: pointer;
  border-left: 3px solid transparent;
}
.nav-item:hover { color: var(--gold); background: rgba(196,161,77,0.15); }
.nav-item.active { color: var(--gold); border-left-color: var(--gold); background: rgba(196,161,77,0.05); }
.nav-item i { width: 18px; font-size: 14px; text-align: center; }
.sidebar-footer { padding: 20px 24px; border-top: 1px solid var(--border); font-size: 10px; letter-spacing: 2px; color: #333; text-align: center; }
.main-content { margin-left: var(--sidebar-width); flex: 1; min-height: 100vh; display: flex; flex-direction: column; }
.top-bar {
  border-bottom: 1px solid var(--border);
  padding: 20px 36px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  background: rgba(0,0,0,0.8);
  backdrop-filter: blur(10px);
  position: sticky;
  top: 0;
  z-index: 50;
}
.page-heading { font-size: 28px; font-weight: 700; letter-spacing: 2px; }
.top-bar-right { display: flex; gap: 10px; align-items: center; }
.btn-header {
  border: 1px solid var(--gold);
  color: #fff;
  background: #000;
  padding: 8px 18px;
  font-size: 11px;
  letter-spacing: 2px;
  font-family: 'Playfair Display', serif;
  cursor: pointer;
  transition: 0.3s;
  white-space: nowrap;
  text-decoration: none;
  display: inline-block;
}
.btn-header:hover { background: var(--gold); color: #000; }
.btn-logout {
  border: 1px solid var(--gold);
  color: var(--gold);
  background: #000;
  padding: 8px 18px;
  font-size: 10px;
  letter-spacing: 2px;
  font-family: 'Playfair Display', serif;
  cursor: pointer;
  transition: 0.3s;
}
.btn-logout:hover { background: var(--gold); color: #000; }
.content-wrap { padding: 36px; flex: 1; }
.table-card { border: 1px solid var(--border); background: var(--card); }
.table-header {
  padding: 28px 32px 20px;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
  border-bottom: 1px solid var(--border-dim);
}
.table-title { font-size: 13px; letter-spacing: 4px; color: var(--gold); font-weight: 600; line-height: 1.4; }
.table-subtitle { font-size: 12px; color: var(--text-muted); letter-spacing: 1px; margin-top: 6px;}
.search-wrap { position: relative; display: flex; align-items: center; }
.search-wrap input {
  background: #050505;
  border: 1px solid #2a2a2a;
  color: #fff;
  padding: 11px 40px 11px 42px;
  font-family: 'Playfair Display', serif;
  font-size: 12px;
  letter-spacing: 1px;
  outline: none;
  width: 280px;
  transition: border-color 0.2s;
}
.search-wrap input:focus { border-color: var(--gold); }
.search-wrap input::placeholder { color: #444; }
.search-icon { position: absolute; left: 14px; color: #444; font-size: 13px; pointer-events: none; transition: color 0.2s; }
.search-wrap:focus-within .search-icon { color: var(--gold); }
.search-clear {
  position: absolute; right: 12px;
  background: none; border: none;
  color: #555; font-size: 14px;
  cursor: pointer; display: none;
  line-height: 1; transition: color 0.2s; padding: 2px 4px;
}
.search-clear:hover { color: var(--gold); }
.search-clear.visible { display: flex; align-items: center; }
.customers-table { width: 100%; border-collapse: collapse; }
.customers-table thead tr { border-bottom: 1px solid var(--border-dim); }
.customers-table th {
  padding: 16px 20px; text-align: left;
  font-size: 10px; letter-spacing: 3px;
  color: var(--gold); font-weight: 700;
}
.customers-table tbody tr { border-bottom: 1px solid #0d0d0d; transition: background 0.2s; }
.customers-table tbody tr:hover { background: #0d0d0d; }
.customers-table td { padding: 18px 20px; font-size: 13px; vertical-align: middle; }
.td-no { color: var(--text-muted); font-size: 11px; letter-spacing: 2px; width: 60px; }
.avatar-cell { display: flex; align-items: center; gap: 14px; }
.avatar {
  width: 38px; height: 38px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 13px; font-weight: 700; letter-spacing: 1px; flex-shrink: 0;
}
.customer-name { font-size: 14px; letter-spacing: 1px; }
.customer-email { font-size: 11px; color: var(--text-muted); letter-spacing: 0.5px; margin-top: 3px; }
.badge {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 5px 12px; font-size: 10px; letter-spacing: 2px;
  font-weight: 600; border-radius: 2px;
}
.badge::before { content: ''; width: 5px; height: 5px; border-radius: 50%; }
.badge-active { background: rgba(46,204,113,0.1); color: var(--active-green); border: 1px solid rgba(46,204,113,0.25); }
.badge-active::before { background: var(--active-green); }
.badge-blocked { background: rgba(231,76,60,0.1); color: var(--blocked-red); border: 1px solid rgba(231,76,60,0.25); }
.badge-blocked::before { background: var(--blocked-red); }
.action-cell { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
.btn-action {
  padding: 7px 16px; font-size: 10px; letter-spacing: 2px;
  font-family: 'Playfair Display', serif;
  cursor: pointer; transition: all 0.25s;
  white-space: nowrap; border: 1px solid; background: transparent;
}
/* Block — outlined, gold fill on hover only */
.btn-block { border-color: var(--gold); color: var(--gold); background: transparent; }
.btn-block:hover:not(:disabled) { background: var(--gold); color: #000; }
.btn-block:disabled { opacity: 0.25; cursor: not-allowed; pointer-events: none; }
/* Unblock — same */
.btn-unblock { border-color: var(--gold); color: var(--gold); background: transparent; }
.btn-unblock:hover:not(:disabled) { background: var(--gold); color: #000; }
.btn-unblock:disabled { opacity: 0.25; cursor: not-allowed; pointer-events: none; }
.empty-state { padding: 60px 20px; text-align: center; color: var(--text-muted); }
.empty-state i { font-size: 36px; color: #2a2a2a; margin-bottom: 16px; display: block; }
.empty-state p { font-size: 12px; letter-spacing: 2px; }
.table-footer {
  padding: 22px 32px; display: flex; align-items: center;
  justify-content: space-between; flex-wrap: wrap; gap: 14px;
  border-top: 1px solid var(--border-dim);
}
.count-text { font-size: 10px; letter-spacing: 3px; color: var(--text-muted); }
.pagination { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
.page-btn {
  width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;
  background: transparent; border: 1px solid #2a2a2a; color: #666;
  font-family: 'Playfair Display', serif; font-size: 12px;
  cursor: pointer; transition: all 0.2s; text-decoration: none;
}
.page-btn:hover { border-color: var(--gold); color: var(--gold); }
.page-btn.active { background: var(--gold); border-color: var(--gold); color: #000; font-weight: 700; }
.page-btn.disabled { opacity: 0.3; pointer-events: none; }
.admin-footer { padding: 24px 36px; border-top: 1px solid var(--border-dim); text-align: center; font-size: 10px; letter-spacing: 3px; color: #2a2a2a; }
#toast {
  display: none; position: fixed; top: 24px; left: 50%; transform: translateX(-50%);
  background: #000; border: 1px solid var(--gold); color: var(--gold);
  padding: 14px 28px; font-family: 'Playfair Display', serif;
  font-size: 12px; letter-spacing: 2px; z-index: 9999; max-width: 90vw; text-align: center;
}
.confirm-overlay {
  display: none; position: fixed; inset: 0;
  background: rgba(0,0,0,0.9); z-index: 1200;
  align-items: center; justify-content: center; padding: 20px;
}
.confirm-overlay.active { display: flex; }
.confirm-box {
  background: #0a0a0a; border: 1px solid #2a2a2a;
  padding: 36px 32px; width: 100%; max-width: 380px;
  text-align: center; animation: fadeInUp 0.3s ease;
}
@keyframes fadeInUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
.confirm-icon { font-size: 28px; margin-bottom: 16px; }
.confirm-title { font-size: 14px; letter-spacing: 2px; color: #fff; margin-bottom: 10px; }
.confirm-desc { font-size: 12px; color: #666; letter-spacing: 1px; line-height: 1.7; margin-bottom: 28px;}
.confirm-actions { display: flex; gap: 12px; }
.confirm-yes {
  flex: 1; padding: 13px; background: var(--gold); color: #000; border: none;
  font-family: 'Playfair Display', serif; font-size: 11px; letter-spacing: 3px;
  font-weight: 700; cursor: pointer; transition: 0.2s;
}
.confirm-yes:hover { background: var(--gold-light); }
.confirm-no {
  flex: 1; padding: 13px; background: transparent;
  border: 1px solid #2a2a2a; color: #555;
  font-family: 'Playfair Display', serif; font-size: 11px;
  letter-spacing: 2px; cursor: pointer; transition: 0.2s;
}
.confirm-no:hover { color: #fff; border-color: #555; }
.hamburger {
  display: none; background: none; border: 1px solid #2a2a2a;
  color: var(--gold); width: 38px; height: 38px;
  cursor: pointer; align-items: center; justify-content: center;
  font-size: 16px; transition: 0.2s; flex-shrink: 0;
}
.hamburger:hover { border-color: var(--gold); }
.sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); z-index: 99; }

/* ── RESPONSIVE ── */
@media (max-width: 900px) {
  .sidebar { transform: translateX(-100%); }
  .sidebar.open { transform: translateX(0); }
  .sidebar-overlay.active { display: block; }
  .main-content { margin-left: 0; }
  .hamburger { display: flex; }
  .top-bar { padding: 16px 20px; }
  .page-heading { font-size: 22px; }
  .content-wrap { padding: 20px 16px; }
  .table-header { padding: 20px 20px 16px; flex-direction: column; align-items: stretch; }
  .search-wrap { width: 100%; }
  .search-wrap input { width: 100%; }
  .customers-table th, .customers-table td { padding: 14px 10px; }
  .customers-table th:nth-child(1), .customers-table td:nth-child(1) { display: none; }
  .customers-table th:nth-child(3), .customers-table td:nth-child(3) { display: none; }
  .table-footer { padding: 16px 20px; flex-direction: column; align-items: flex-start; }
}
@media (max-width: 600px) {
  .top-bar-right .btn-header { display: none; }
  .page-heading { font-size: 18px; }
  .customers-table th, .customers-table td { padding: 12px 8px; }
  .avatar { width: 32px; height: 32px; font-size: 11px; }
  .customer-name { font-size: 13px; }
  .customer-email { font-size: 10px; }
  .action-cell { flex-direction: column; gap: 6px; align-items: stretch; }
  .btn-action { width: 100%; text-align: center; }
  .customers-table th:nth-child(4), .customers-table td:nth-child(4) { display: none; }
}
@media (max-width: 400px) {
  .content-wrap { padding: 12px 8px; }
  .page-btn { width: 30px; height: 30px; font-size: 11px; }
  .pagination { gap: 4px; }
  .table-footer { padding: 12px 10px; }
}
</style>
</head>
<body>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<aside class="sidebar" id="sidebar">
 <div class="sidebar-logo">
        <span class="logo-text"><i class="fas fa-gem me-2" style="color:var(--gold)"></i>ROYALMIST</span>
    </div>
  <nav class="sidebar-nav">
    <a class="nav-item" href="/admin/dashboard"><i class="fa-solid fa-border-all"></i>Dashboard</a>
    <a class="nav-item" href="/admin/products"><i class="fa-solid fa-box-open"></i>Products</a>
    <a class="nav-item" href="/admin/categories"><i class="fa-solid fa-tag"></i>Categories</a>
    <a class="nav-item" href="/admin/coupons"><i class="fa-solid fa-ticket"></i>Coupons</a>
    <a class="nav-item active" href="/admin/customers"><i class="fa-solid fa-users"></i>Customers</a>
    <a class="nav-item" href="/admin/orders"><i class="fa-solid fa-bag-shopping"></i>Orders</a>
    <a class="nav-item" href="/admin/inventory"><i class="fa-solid fa-warehouse"></i>Inventory</a>
    <a class="nav-item" href="/admin/product-offer"><i class="fa-solid fa-percent"></i>Product Offer</a>
    <a class="nav-item" href="/admin/category-offer"><i class="fa-solid fa-layer-group"></i>Category Offer</a>
    <a class="nav-item" href="/admin/sales-report"><i class="fa-solid fa-chart-bar"></i>Sales Report</a>
    <a class="nav-item" href="/admin/logout"><i class="fa-solid fa-right-from-bracket"></i>Logout</a>
</nav>
  <div class="sidebar-footer">ROYALMIST ADMIN v2.0</div>
</aside>

<div class="main-content">
  <div class="top-bar">
    <div style="display:flex;align-items:center;gap:14px;">
      <button class="hamburger" id="hamburger"><i class="fa-solid fa-bars"></i></button>
      <h1 class="page-heading">Customers</h1>
    </div>
  </div>

  <div class="content-wrap">
    <div class="table-card">
      <div class="table-header">
        <div>
          <div class="table-title">CUSTOMER<br>MANAGEMENT</div>
          <div class="table-subtitle">Review and manage client accounts and their access status.</div>
        </div>
        <form method="GET" action="/admin/customers" id="searchForm">
          <div class="search-wrap">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input type="text" name="search" id="searchInput"
              placeholder="Search customers..."
              value="<%= search %>" autocomplete="off">
            <button type="button" class="search-clear <%= search ? 'visible' : '' %>" id="clearBtn" title="Clear search">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>
        </form>
      </div>

      <div style="overflow-x:auto;">
        <% if (customers.length === 0) { %>
          <div class="empty-state">
            <i class="fa-solid fa-users-slash"></i>
            <p>NO CUSTOMERS FOUND</p>
          </div>
        <% } else { %>
        <table class="customers-table">
          <thead>
            <tr>
              <th>No.</th>
              <th>Name</th>
              <th>Email</th>
              <th>Status</th>
              <th style="text-align:right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <%
              const avatarBg   = ['#c4a14d22','#2ecc7122','#3498db22','#9b59b622','#1abc9c22','#e74c3c22'];
              const avatarText = ['#c4a14d','#2ecc71','#3498db','#9b59b6','#1abc9c','#e74c3c'];
            %>
            <% customers.forEach(function(customer, i) { %>
              <%
                const globalIndex = (currentPage - 1) * pageSize + i + 1;
                const no         = String(globalIndex).padStart(2, '0');
                const initials   = (customer.firstName[0] + (customer.lastName ? customer.lastName[0] : '')).toUpperCase();
                const ci         = customer._id.toString().charCodeAt(0) % avatarBg.length;
                const fullName   = customer.firstName + ' ' + (customer.lastName || '');
                const isBlocked  = customer.isBlocked;
              %>
              <tr>
                <td class="td-no"><%= no %></td>
                <td>
                  <div class="avatar-cell">
                    <div class="avatar" style="background:<%= avatarBg[ci] %>;color:<%= avatarText[ci] %>;border:1px solid <%= avatarText[ci] %>40;">
                      <%= initials %>
                    </div>
                    <div>
                      <div class="customer-name"><%= fullName %></div>
                      <div class="customer-email"><%= customer.email %></div>
                    </div>
                  </div>
                </td>
                <td style="font-size:12px;color:#aaa;letter-spacing:0.5px;"><%= customer.email %></td>
                <td>
                  <% if (isBlocked) { %>
                    <span class="badge badge-blocked">Blocked</span>
                  <% } else { %>
                    <span class="badge badge-active">Active</span>
                  <% } %>
                </td>
                <td>
                  <div class="action-cell">
                    <button class="btn-action btn-block" <%= isBlocked ? 'disabled' : '' %> onclick="confirmAction('<%= customer._id %>', 'block', '<%= fullName %>')">Block</button>
                    <button class="btn-action btn-unblock" <%= !isBlocked ? 'disabled' : '' %> onclick="confirmAction('<%= customer._id %>', 'unblock', '<%= fullName %>')">Unblock</button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <% } %>
      </div>

      <div class="table-footer">
        <div class="count-text">SHOWING <%= customers.length %> OF <%= total %> CUSTOMERS</div>
        <div class="pagination">
          <% if (currentPage > 1) { %>
            <a class="page-btn" href="/admin/customers?page=<%= currentPage - 1 %>&search=<%= search %>">
              <i class="fa-solid fa-chevron-left" style="font-size:10px;"></i>
            </a>
          <% } else { %>
            <span class="page-btn disabled"><i class="fa-solid fa-chevron-left" style="font-size:10px;"></i></span>
          <% } %>
          <% for (let p = 1; p <= totalPages; p++) { %>
            <a class="page-btn <%= p === currentPage ? 'active' : '' %>" href="/admin/customers?page=<%= p %>&search=<%= search %>"><%= p %></a>
          <% } %>
          <% if (currentPage < totalPages) { %>
            <a class="page-btn" href="/admin/customers?page=<%= currentPage + 1 %>&search=<%= search %>">
              <i class="fa-solid fa-chevron-right" style="font-size:10px;"></i>
            </a>
          <% } else { %>
            <span class="page-btn disabled"><i class="fa-solid fa-chevron-right" style="font-size:10px;"></i></span>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <div class="admin-footer">ROYALMIST PREMIUM ADMIN INTERFACE</div>
</div>

<div class="confirm-overlay" id="confirmModal">
  <div class="confirm-box">
    <div class="confirm-icon" id="confirmIcon">⚠</div>
    <div class="confirm-title" id="confirmTitle">Confirm Action</div>
    <div class="confirm-desc" id="confirmDesc">Are you sure?</div>
    <div class="confirm-actions">
      <button class="confirm-no" id="confirmNo">Cancel</button>
      <button class="confirm-yes" id="confirmYes">Confirm</button>
    </div>
  </div>
</div>

<div id="toast"></div>

<script>
const searchInput = document.getElementById('searchInput');
const clearBtn    = document.getElementById('clearBtn');
const searchForm  = document.getElementById('searchForm');
let searchTimer;

searchInput.addEventListener('input', function () {
  clearBtn.classList.toggle('visible', this.value.length > 0);
  clearTimeout(searchTimer);
  searchTimer = setTimeout(() => searchForm.submit(), 500);
});

clearBtn.addEventListener('click', function () {
  searchInput.value = '';
  clearBtn.classList.remove('visible');
  window.location.href = '/admin/customers?page=1&search=';
});

let pendingId     = null;
let pendingAction = null;

function confirmAction(id, action, name) {
  pendingId     = id;
  pendingAction = action;
  const isBlock = action === 'block';
  document.getElementById('confirmIcon').textContent  = isBlock ? '🔒' : '🔓';
  document.getElementById('confirmTitle').textContent = isBlock ? 'Block Customer' : 'Unblock Customer';
  document.getElementById('confirmDesc').innerHTML    = `Are you sure you want to ${action}<br><strong style="color:var(--gold);font-style:normal;">${name}</strong>?`;
  const yesBtn            = document.getElementById('confirmYes');
  yesBtn.textContent      = isBlock ? 'Block' : 'Unblock';
  yesBtn.style.background = isBlock ? '#c0392b' : 'var(--gold)';
  yesBtn.style.color      = '#fff';
  document.getElementById('confirmModal').classList.add('active');
}

document.getElementById('confirmNo').addEventListener('click', () => {
  document.getElementById('confirmModal').classList.remove('active');
  pendingId = pendingAction = null;
});

document.getElementById('confirmYes').addEventListener('click', async () => {
  document.getElementById('confirmModal').classList.remove('active');
  if (!pendingId) return;
  try {
    const res  = await fetch(`/admin/customers/${pendingId}/${pendingAction}`, { method: 'PATCH' });
    const data = await res.json();
    if (data.success) {
      showToast(data.message, 'success');
      setTimeout(() => location.reload(), 1200);
    } else {
      showToast(data.message || 'Something went wrong', 'fail');
    }
  } catch {
    showToast('Network error. Try again.', 'fail');
  }
  pendingId = pendingAction = null;
});

function showToast(msg, type) {
  const t             = document.getElementById('toast');
  t.innerHTML         = type === 'fail' ? '⚠ ' + msg : '✓ ' + msg;
  t.style.color       = type === 'fail' ? '#e74c3c' : 'var(--gold)';
  t.style.borderColor = type === 'fail' ? '#e74c3c' : 'var(--gold)';
  t.style.display     = 'block';
  setTimeout(() => t.style.display = 'none', 3000);
}

document.getElementById('hamburger').addEventListener('click', () => {
  document.getElementById('sidebar').classList.add('open');
  document.getElementById('sidebarOverlay').classList.add('active');
});
document.getElementById('sidebarOverlay').addEventListener('click', () => {
  document.getElementById('sidebar').classList.remove('open');
  document.getElementById('sidebarOverlay').classList.remove('active');
});
</script>
</body>
</html>