 <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Sign In | Royal Mist</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --gold: #c4a14d;
            --dark-bg: #000000;
        }

        * {
            box-sizing: border-box;
        }

        body {
            background-color: var(--dark-bg);
            color: #fff;
            font-family: 'Montserrat', sans-serif;
            min-height: 100vh;
        }

        h2 {
            font-family: 'Playfair Display', serif;
            font-size: 2.5rem;
        }

        .signin-container {
            max-width: 400px;
            margin: 80px auto;
            padding: 20px;
        }

        .admin-badge {
            display: inline-flex;
            align-items: center;
            background: rgba(196, 161, 77, 0.1);
            border: 1px solid rgba(196, 161, 77, 0.35);
            color: var(--gold);
            font-size: 0.65rem;
            letter-spacing: 3px;
            text-transform: uppercase;
            padding: 6px 14px;
            border-radius: 2px;
            margin-bottom: 18px;
        }

        label {
            color: var(--gold);
            font-size: 0.75rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 8px;
            display: block;
        }

        input {
            background: transparent !important;
            border: 2px solid #222 !important;
            color: #fff !important;
            border-radius: 0 !important;
            padding: 12px !important;
            margin-bottom: 20px;
            width: 100%;
        }

        input:focus {
            border-color: var(--gold) !important;
            box-shadow: none !important;
            outline: none;
        }

        .btn-signin {
            background: linear-gradient(to right, #c4a14d, #b59242);
            color: #000;
            border: none;
            width: 100%;
            padding: 15px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
            transition: 0.3s;
            font-family: 'Montserrat', sans-serif;
            cursor: pointer;
        }

        .btn-signin:hover {
            background: #e2bd65;
            transform: translateY(-2px);
        }

        a {
            color: var(--gold);
            text-decoration: none;
        }

        .field-error {
            color: red;
            font-size: 12px;
            display: none;
            margin-top: -16px;
            margin-bottom: 14px;
        }

        #signinToast {
            display: none;
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: black;
            color: #c4a14d;
            border: 2px solid #c4a14d;
            padding: 15px 25px;
            font-weight: 700;
            border-radius: 8px;
            font-family: 'Montserrat', sans-serif;
            z-index: 9999;
            align-items: center;
            gap: 10px;
            box-shadow: 0 0 10px rgba(0,0,0,0.5);
            white-space: nowrap;
        }

        .password-wrapper {
            position: relative;
        }

        .password-wrapper input {
            padding-right: 45px !important;
        }

        #toggle-password {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-65%);
            background: none;
            border: none;
            color: #fff;
            cursor: pointer;
            display: none;
            padding: 0;
        }

        input:-webkit-autofill {
            -webkit-box-shadow: 0 0 0px 1000px var(--dark-bg) inset !important;
            -webkit-text-fill-color: #fff !important;
            transition: background-color 5000s ease-in-out 0s;
        }

        input:-webkit-autofill:focus {
            -webkit-box-shadow: 0 0 0px 1000px var(--dark-bg) inset !important;
            -webkit-text-fill-color: #fff !important;
        }

        @media (max-width: 480px) {
            h2 {
                font-size: 2rem;
            }

            .signin-container {
                margin: 40px auto;
                padding: 20px 18px;
            }

            .btn-signin {
                padding: 13px;
                font-size: 0.78rem;
            }

            #signinToast {
                width: 90%;
                font-size: 0.82rem;
                padding: 12px 18px;
                white-space: normal;
                text-align: center;
            }
        }
    </style>
</head>
<body>

    <div id="signinToast">
        <span style="font-size:18px;">✅</span>
        <span id="signinText">Admin signin successful</span>
    </div>

    <div class="container signin-container">

        <div class="text-center">
            <div class="admin-badge">Admin Portal</div>
        </div>

        <h2 class="text-center mb-2">Sign In</h2>
        <p class="text-center text-secondary mb-5 small">Restricted access — Royal Mist Admin</p>

        <form id="signinForm">
            <label>Email Address</label>
            <input type="text" id="email" name="email" class="form-control" placeholder="admin@royalmist.com">
            <p id="email-error" class="field-error"></p>

            <label>Password</label>
            <div class="password-wrapper">
                <input type="password" id="password" name="password" class="form-control" placeholder="••••••••">
                <button type="button" id="toggle-password">
                    <i class="fa fa-eye"></i>
                </button>
            </div>
            <p id="password-error" class="field-error"></p>

            <button type="submit" class="btn-signin">Sign In →</button>
        </form>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const form = document.getElementById("signinForm");
        const emailInput = document.getElementById("email");
        const passwordInput = document.getElementById("password");
        const emailError = document.getElementById("email-error");
        const passwordError = document.getElementById("password-error");
        const toast = document.getElementById("signinToast");
        const toastText = document.getElementById("signinText");
        const togglePassword = document.getElementById("toggle-password");

        emailInput.addEventListener("input", () => {
            emailError.style.display = "none";
        });

        passwordInput.addEventListener("input", () => {
            passwordError.style.display = "none";
            if (passwordInput.value.length > 0) {
                togglePassword.style.display = "block";
            } else {
                togglePassword.style.display = "none";
                passwordInput.setAttribute("type", "password");
                togglePassword.innerHTML = '<i class="fa fa-eye"></i>';
            }
        });

        togglePassword.addEventListener("click", () => {
            const type = passwordInput.getAttribute("type") === "password" ? "text" : "password";
            passwordInput.setAttribute("type", type);
            togglePassword.innerHTML = type === "password"
                ? '<i class="fa fa-eye"></i>'
                : '<i class="fa fa-eye-slash"></i>';
        });

        form.addEventListener("submit", async (e) => {
            e.preventDefault();

            emailError.style.display = "none";
            passwordError.style.display = "none";

            const emailVal = emailInput.value.trim();
            const passwordVal = passwordInput.value;
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

            let hasError = false;

            if (!emailVal) {
                emailError.innerText = "Email is required.";
                emailError.style.display = "block";
                hasError = true;
            } else if (!emailRegex.test(emailVal)) {
                emailError.innerText = "Enter a valid email address.";
                emailError.style.display = "block";
                hasError = true;
            }

            if (!passwordVal) {
                passwordError.innerText = "Password is required.";
                passwordError.style.display = "block";
                hasError = true;
            } else if (passwordVal.length < 6) {
                passwordError.innerText = "Password must be at least 6 characters.";
                passwordError.style.display = "block";
                hasError = true;
            }

            if (hasError) return;

            const formData = {
                email: emailVal,
                password: passwordVal
            };

            try {
                const res = await fetch("/admin/signin", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(formData),
                    credentials: "include"
                });

                const data = await res.json();

                if (data.success) {
                    toastText.innerText = data.message || "Admin signin successful";
                    toast.style.display = "flex";

                    setTimeout(() => {
                        toast.style.display = "none";
                        window.location.href = "/admin/dashboard";
                    }, 2000);
                } else {
                    if (data.errors && data.errors.email) {
                        emailError.innerText = data.errors.email;
                        emailError.style.display = "block";
                    }
                    if (data.errors && data.errors.password) {
                        passwordError.innerText = data.errors.password;
                        passwordError.style.display = "block";
                    }
                }
            } catch (err) {
                console.log(err);
            }
        });
    </script>
</body>
</html>
