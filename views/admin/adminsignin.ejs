<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin| Royal Mist</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root { 
            --gold: #c4a14d; 
            --dark-bg: #000000; 
        }

        body { 
            background-color: var(--dark-bg); 
            color: #fff; 
            font-family: 'Montserrat', sans-serif; 
        }

        h2 { font-family: 'Playfair Display', serif; font-size: 2.5rem; }
        
        .signin-container { 
            max-width: 400px; 
            margin: 80px auto; 
            padding: 20px; 
        }

        label { 
            color: var(--gold); 
            font-size: 0.75rem; 
            letter-spacing: 2px; 
            text-transform: uppercase; 
            margin-bottom: 8px; 
            display: block; 
        }
        
        input { 
            background: transparent !important; 
            border: 2px solid #222 !important; 
            color: #fff !important; 
            border-radius: 0 !important; 
            padding: 12px !important; 
            margin-bottom: 20px; 
        }

        input:focus { 
            border-color: var(--gold) !important; 
            box-shadow: none !important; 
        }
        
        .btn-signin { 
            background: linear-gradient(to right, #c4a14d, #b59242); 
            color: #000; 
            border: none; 
            width: 100%; 
            padding: 15px; 
            font-weight: 700; 
            text-transform: uppercase; 
            letter-spacing: 2px; 
            transition: 0.3s; 
        }

        .btn-signin:hover { 
            background: #e2bd65; 
            transform: translateY(-2px);
        }
        
        .forgot-link { 
            color: #888; 
            font-size: 0.75rem; 
            text-decoration: none; 
            display: block; 
            margin-bottom: 20px; 
        }

        a { color: var(--gold); text-decoration: none; }
        .footer-text { color: #555; font-size: 0.8rem; margin-top: 30px; }

        input:-webkit-autofill {
            -webkit-box-shadow: 0 0 0px 1000px var(--dark-bg) inset !important;
            -webkit-text-fill-color: #fff !important;
        }
    </style>
</head>

<body>

<!-- Toast -->
<div id="signinToast" style="
    display:none;
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: black;
    color: #c4a14d;
    border: 2px solid #c4a14d;
    padding: 15px 25px;
    font-weight: 700;
    border-radius: 8px;
    z-index: 9999;
">
    <span id="signinText">Admin Signin successful</span>
</div>

<div class="container signin-container">
    <h2 class="text-center mb-2">Admin</h2>
    <p class="text-center text-secondary mb-5 small">Restricted Access</p>

    <form id="signinForm">
        <label>Email Address</label>
        <input type="text" id="email" class="form-control" placeholder="admin@royalmist.com" autofocus>
        <p id="email-error" style="color:red; font-size:12px; display:none;"></p>

        <label>Password</label>
        <input type="password" id="password" class="form-control" placeholder="••••••••">
        <p id="password-error" style="color:red; font-size:12px; display:none;"></p>
        
        <button type="submit" class="btn-signin">Sign In →</button>
    </form>

    <p class="text-center footer-text">Admin Access Only</p>
</div>

<script>
const form = document.getElementById("signinForm");
const emailInput = document.getElementById("email");
const passwordInput = document.getElementById("password");
const emailError = document.getElementById("email-error");
const passwordError = document.getElementById("password-error");
const toast = document.getElementById("signinToast");
const toastText = document.getElementById("signinText");

form.addEventListener("submit", async (e) => {
  e.preventDefault();

  emailError.style.display = "none";
  passwordError.style.display = "none";

  const formData = {
    email: emailInput.value.trim(),
    password: passwordInput.value
  };

  try {
    const res = await fetch("/admin/signin", { 
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(formData)
    });

    const data = await res.json();

    if (data.success) {
      toastText.innerText = data.message || "Admin Signin successful";
      toast.style.display = "block";

      setTimeout(() => {
        window.location.href = "/admin/dashboard";
      }, 2000);
    } else {
      if (data.errors?.email) {
        emailError.innerText = data.errors.email;
        emailError.style.display = "block";
      }
      if (data.errors?.password) {
        passwordError.innerText = data.errors.password;
        passwordError.style.display = "block";
      }
    }
  } catch (err) {
    console.log(err);
  }
});
</script>

</body>
</html>