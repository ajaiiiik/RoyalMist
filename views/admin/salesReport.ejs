<%# views/admin/salesReport.ejs %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Sales Report | Royal Mist Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    :root{--gold:#c4a14d;--gold-dim:rgba(196,161,77,0.12);--bg:#000;--sidebar-bg:#050505;--card:#0a0a0a;--border:#1a1a1a;--text:#fff;--muted:#888;--dim:#555;--sidebar-w:240px;--green:#4caf82;--red:#e05252;--orange:#f39c12;--blue:#5b8cff;}
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:var(--bg);color:var(--text);font-family:'Playfair Display',serif;min-height:100vh;display:flex;}
    .sidebar{width:var(--sidebar-w);min-height:100vh;background:var(--sidebar-bg);border-right:1px solid #111;display:flex;flex-direction:column;position:fixed;top:0;left:0;z-index:100;transition:transform 0.3s;}
    .sidebar-logo{display:flex;align-items:center;gap:10px;padding:28px 24px 24px;border-bottom:1px solid #111;}
    .logo-icon{width:36px;height:36px;background:var(--gold);clip-path:polygon(0 0,70% 0,100% 30%,100% 100%,30% 100%,0 70%);flex-shrink:0;}
    .logo-text{font-size:13px;font-weight:700;letter-spacing:4px;color:var(--gold);}
    .nav-menu{flex:1;padding:20px 0;overflow-y:auto;}
    .nav-item{display:flex;align-items:center;gap:14px;padding:13px 24px;color:#666;text-decoration:none;font-size:13px;letter-spacing:1px;transition:all 0.2s;border-left:3px solid transparent;}
    .nav-item:hover{color:var(--gold);background:var(--gold-dim);}
    .nav-item.active{color:var(--gold);border-left-color:var(--gold);background:var(--gold-dim);}
    .nav-item i{width:18px;text-align:center;font-size:13px;}
    .sidebar-footer{padding:20px 24px;border-top:1px solid #111;font-size:10px;letter-spacing:2px;color:#333;text-align:center;}
    .main{margin-left:var(--sidebar-w);flex:1;min-height:100vh;display:flex;flex-direction:column;}
    .topbar{display:flex;align-items:center;justify-content:space-between;padding:18px 28px;border-bottom:1px solid #111;background:var(--bg);position:sticky;top:0;z-index:50;flex-wrap:wrap;gap:12px;}
    .topbar-title{font-size:22px;font-weight:700;}
    .hamburger{display:none;background:none;border:1px solid #222;color:var(--muted);padding:7px 10px;cursor:pointer;font-size:16px;}
    .content{padding:24px 28px;flex:1;}
    /* STAT CARDS */
    .stat-row{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:24px;}
    .stat-card{background:var(--card);border:1px solid var(--border);padding:20px 16px;}
    .stat-icon{width:34px;height:34px;background:var(--gold-dim);display:flex;align-items:center;justify-content:center;color:var(--gold);font-size:14px;margin-bottom:12px;}
    .stat-label{font-size:9px;letter-spacing:2px;color:var(--muted);margin-bottom:4px;}
    .stat-value{font-size:20px;font-weight:700;}
    /* FILTER BAR */
    .filter-bar{background:var(--card);border:1px solid var(--border);padding:16px 20px;margin-bottom:20px;display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end;}
    .filter-grp{display:flex;flex-direction:column;gap:6px;}
    .filter-label{font-size:9px;letter-spacing:2px;color:var(--gold);}
    .filter-input,.filter-select{background:#000;border:1px solid #222;color:#fff;font-family:'Playfair Display',serif;font-size:12px;padding:8px 12px;outline:none;transition:border-color 0.2s;}
    .filter-input:focus,.filter-select:focus{border-color:var(--gold);}
    .filter-select option{background:#111;}
    .btn-apply{background:var(--gold);border:none;color:#000;font-family:'Playfair Display',serif;font-size:10px;letter-spacing:2px;font-weight:700;padding:8px 18px;cursor:pointer;align-self:flex-end;}
    .btn-apply:hover{background:#b38f3d;}
    .btn-dl{background:transparent;border:1px solid #2a2a2a;color:#888;font-family:'Playfair Display',serif;font-size:10px;letter-spacing:2px;padding:8px 14px;cursor:pointer;align-self:flex-end;text-decoration:none;display:inline-flex;align-items:center;gap:6px;transition:0.2s;}
    .btn-dl:hover{border-color:var(--gold);color:var(--gold);}
    .btn-dl.excel{border-color:#1a3a1a;color:var(--green);}
    .btn-dl.excel:hover{background:rgba(76,175,130,0.1);}
    /* CHART */
    .chart-card{background:var(--card);border:1px solid var(--border);padding:24px;margin-bottom:20px;}
    .chart-title{font-size:11px;letter-spacing:3px;color:var(--gold);margin-bottom:20px;}
    .chart-wrap{height:260px;}
    /* BOTTOM GRID */
    .bottom-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;}
    /* TABLE */
    .table-card{background:var(--card);border:1px solid var(--border);overflow:hidden;}
    .table-header{padding:16px 20px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;}
    .table-title{font-size:11px;letter-spacing:2px;color:var(--gold);}
    table{width:100%;border-collapse:collapse;}
    thead tr{background:#050505;border-bottom:1px solid var(--border);}
    th{padding:10px 14px;font-size:9px;letter-spacing:2px;color:var(--muted);text-align:left;white-space:nowrap;}
    tbody tr{border-bottom:1px solid #0d0d0d;transition:background 0.15s;}
    tbody tr:hover{background:#0f0f0f;}
    tbody tr:last-child{border-bottom:none;}
    td{padding:12px 14px;font-size:12px;vertical-align:middle;}
    .order-id{color:var(--gold);font-weight:700;font-size:11px;}
    /* STATUS */
    .s-chip{display:inline-block;font-size:9px;letter-spacing:1px;padding:3px 8px;border:1px solid;}
    .s-Delivered{border-color:#1a3a2a;color:var(--green);}
    .s-Pending{border-color:#555;color:#888;}
    .s-Shipped{border-color:#3a2a00;color:var(--orange);}
    .s-Processing{border-color:#1a2a3a;color:var(--blue);}
    /* TOP PRODUCTS */
    .prod-item{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid #0d0d0d;}
    .prod-item:last-child{border-bottom:none;}
    .prod-rank{width:22px;height:22px;background:var(--gold-dim);border:1px solid var(--gold);color:var(--gold);font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
    .prod-info{flex:1;min-width:0;}
    .prod-name{font-size:12px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .prod-qty{font-size:10px;color:var(--dim);}
    .prod-rev{font-size:12px;color:var(--gold);font-weight:600;flex-shrink:0;}
    /* STATUS BREAKDOWN */
    .status-list{padding:0;}
    .status-item{display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-bottom:1px solid #0d0d0d;}
    .status-item:last-child{border-bottom:none;}
    .status-dot{width:8px;height:8px;border-radius:50%;margin-right:10px;flex-shrink:0;}
    /* SIDEBAR OVERLAY */
    .sidebar-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:99;}
    .sidebar-overlay.active{display:block;}
    @media(max-width:1100px){.stat-row{grid-template-columns:repeat(2,1fr);}.bottom-grid{grid-template-columns:1fr;}}
    @media(max-width:900px){.main{margin-left:0;}.sidebar{transform:translateX(-100%);}.sidebar.open{transform:translateX(0);}.hamburger{display:flex;align-items:center;}.content{padding:16px;}.topbar{padding:14px;}.stat-row{grid-template-columns:1fr 1fr;}.filter-bar{flex-direction:column;}}
    @media(max-width:500px){.stat-row{grid-template-columns:1fr;}}
  </style>
</head>
<body>
<div class="sidebar-overlay" id="sidebarOverlay"></div>
<aside class="sidebar" id="sidebar">
 <div class="sidebar-logo">
        <span class="logo-text"><i class="fas fa-gem me-2" style="color:var(--gold)"></i>ROYALMIST</span>
    </div>
  <nav class="nav-menu">
    <a class="nav-item" href="/admin/dashboard"><i class="fa-solid fa-border-all"></i><span>Dashboard</span></a>
    <a class="nav-item" href="/admin/products"><i class="fa-solid fa-box-open"></i><span>Products</span></a>
    <a class="nav-item" href="/admin/categories"><i class="fa-solid fa-tag"></i><span>Categories</span></a>
    <a class="nav-item" href="/admin/coupons"><i class="fa-solid fa-ticket"></i><span>Coupons</span></a>
    <a class="nav-item" href="/admin/customers"><i class="fa-solid fa-users"></i><span>Customers</span></a>
    <a class="nav-item" href="/admin/orders"><i class="fa-solid fa-bag-shopping"></i><span>Orders</span></a>
    <a class="nav-item" href="/admin/inventory"><i class="fa-solid fa-warehouse"></i><span>Inventory</span></a>
    <a class="nav-item" href="/admin/product-offer"><i class="fa-solid fa-percent"></i><span>Product Offer</span></a>
    <a class="nav-item" href="/admin/category-offer"><i class="fa-solid fa-layer-group"></i><span>Category Offer</span></a>
    <a class="nav-item active" href="/admin/sales-report"><i class="fa-solid fa-chart-bar"></i><span>Sales Report</span></a>
    <a class="nav-item" href="/admin/logout"><i class="fa-solid fa-right-from-bracket"></i><span>Logout</span></a>
  </nav>
  <div class="sidebar-footer">ROYALMIST ADMIN v2.0</div>
</aside>

<div class="main">
  <div class="topbar">
    <div style="display:flex;align-items:center;gap:14px;">
      <button class="hamburger" id="hamburger"><i class="fas fa-bars"></i></button>
      <h1 class="topbar-title">Sales Report</h1>
    </div>
    <div style="font-size:11px;color:var(--muted);letter-spacing:1px;"><%= from %> — <%= to %></div>
  </div>

  <div class="content">

    <!-- STAT CARDS -->
    <div class="stat-row">
      <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-coins"></i></div>
        <div class="stat-label">Total Revenue</div>
        <div class="stat-value" style="color:var(--gold);">₹<%= totalRevenue.toLocaleString('en-IN') %></div>
      </div>
      <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-shopping-bag"></i></div>
        <div class="stat-label">Total Orders</div>
        <div class="stat-value"><%= totalOrders %></div>
      </div>
      <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-chart-line"></i></div>
        <div class="stat-label">Avg Order Value</div>
        <div class="stat-value">₹<%= avgOrderValue.toLocaleString('en-IN') %></div>
      </div>
      <div class="stat-card" style="border-color:#1a3a00;">
        <div class="stat-icon" style="background:rgba(76,175,130,0.1);color:var(--green);"><i class="fas fa-tag"></i></div>
        <div class="stat-label">Total Discount</div>
        <div class="stat-value" style="color:var(--green);">₹<%= totalDiscount.toLocaleString('en-IN') %></div>
      </div>
    </div>

    <!-- FILTER BAR -->
    <form method="GET" action="/admin/sales-report" id="filterForm">
      <div class="filter-bar">
        <div class="filter-grp">
          <span class="filter-label">Period</span>
          <select class="filter-select" name="period" onchange="toggleCustomDates(this.value)">
            <option value="daily"   <%= filters.period==='daily'   ?'selected':'' %>>Today</option>
            <option value="weekly"  <%= filters.period==='weekly'  ?'selected':'' %>>This Week</option>
            <option value="monthly" <%= filters.period==='monthly' ?'selected':'' %>>This Month</option>
            <option value="yearly"  <%= filters.period==='yearly'  ?'selected':'' %>>This Year</option>
            <option value="custom"  <%= filters.period==='custom'  ?'selected':'' %>>Custom Range</option>
          </select>
        </div>
        <div id="customDates" style="display:<%= filters.period==='custom'?'flex':'none' %>;gap:12px;flex-wrap:wrap;">
          <div class="filter-grp">
            <span class="filter-label">From</span>
            <input type="date" class="filter-input" name="startDate" value="<%= filters.startDate %>"/>
          </div>
          <div class="filter-grp">
            <span class="filter-label">To</span>
            <input type="date" class="filter-input" name="endDate" value="<%= filters.endDate %>"/>
          </div>
        </div>
        <button type="submit" class="btn-apply"><i class="fas fa-search me-1"></i>APPLY</button>
        <a href="/admin/sales-report/download?format=pdf&period=<%= filters.period %>&startDate=<%= filters.startDate %>&endDate=<%= filters.endDate %>" class="btn-dl">
          <i class="fas fa-file-pdf"></i>PDF
        </a>
        <a href="/admin/sales-report/download?format=excel&period=<%= filters.period %>&startDate=<%= filters.startDate %>&endDate=<%= filters.endDate %>" class="btn-dl excel">
          <i class="fas fa-file-csv"></i>EXCEL
        </a>
      </div>
    </form>

    <!-- REVENUE CHART -->
    <div class="chart-card">
      <div class="chart-title"><i class="fas fa-chart-bar me-2"></i>REVENUE PERFORMANCE</div>
      <div class="chart-wrap">
        <canvas id="revenueChart"></canvas>
      </div>
    </div>

    <!-- BOTTOM GRID -->
    <div class="bottom-grid">

      <!-- TOP PRODUCTS -->
      <div class="table-card">
        <div class="table-header"><span class="table-title"><i class="fas fa-trophy me-2"></i>TOP SELLING PRODUCTS</span></div>
        <div style="padding:8px 16px;">
          <% if(topProducts.length === 0) { %>
            <div style="text-align:center;padding:30px;color:var(--dim);font-size:12px;">No data</div>
          <% } else { %>
            <% topProducts.forEach((p, i) => { %>
              <div class="prod-item">
                <div class="prod-rank"><%= i+1 %></div>
                <div class="prod-info">
                  <div class="prod-name"><%= p.name %></div>
                  <div class="prod-qty"><%= p.qty %> units sold</div>
                </div>
                <div class="prod-rev">₹<%= p.revenue.toLocaleString('en-IN') %></div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>

      <!-- ORDER STATUS BREAKDOWN -->
      <div class="table-card">
        <div class="table-header"><span class="table-title"><i class="fas fa-chart-pie me-2"></i>ORDER STATUS</span></div>
        <div style="padding:8px 20px;">
          <% const statusItems = [
            { label: 'Delivered',  value: statusBreakdown.Delivered,  color: '#4caf82' },
            { label: 'Pending',    value: statusBreakdown.Pending,    color: '#888' },
            { label: 'Shipped',    value: statusBreakdown.Shipped,    color: '#f39c12' },
            { label: 'Processing', value: statusBreakdown.Processing, color: '#5b8cff' },
            { label: 'Cancelled',  value: statusBreakdown.Cancelled,  color: '#e05252' },
          ]; %>
          <% const totalAll = Object.values(statusBreakdown).reduce((a,b) => a+b, 0); %>
          <% statusItems.forEach(item => { %>
            <div class="status-item">
              <div style="display:flex;align-items:center;">
                <div class="status-dot" style="background:<%= item.color %>;box-shadow:0 0 6px <%= item.color %>44;"></div>
                <span style="font-size:12px;letter-spacing:1px;"><%= item.label %></span>
              </div>
              <div style="display:flex;align-items:center;gap:14px;">
                <div style="width:80px;height:4px;background:#1a1a1a;border-radius:2px;">
                  <div style="width:<%= totalAll>0 ? Math.round(item.value/totalAll*100) : 0 %>%;height:4px;background:<%= item.color %>;border-radius:2px;"></div>
                </div>
                <span style="font-size:12px;font-weight:700;min-width:28px;text-align:right;"><%= item.value %></span>
              </div>
            </div>
          <% }) %>
        </div>
      </div>

    </div>

    <!-- ORDERS TABLE -->
    <div class="table-card">
      <div class="table-header">
        <span class="table-title"><i class="fas fa-list me-2"></i>ORDER LIST</span>
        <span style="font-size:11px;color:var(--muted);"><%= totalOrders %> orders</span>
      </div>
      <% if(orders.length === 0) { %>
        <div style="text-align:center;padding:40px;color:var(--dim);"><i class="fas fa-shopping-bag" style="font-size:32px;color:#1a1a1a;margin-bottom:12px;display:block;"></i><p>No orders in this period</p></div>
      <% } else { %>
      <div style="overflow-x:auto;">
        <table>
          <thead>
            <tr>
              <th>ORDER ID</th>
              <th>CUSTOMER</th>
              <th>DATE</th>
              <th>PAYMENT</th>
              <th>STATUS</th>
              <th>DISCOUNT</th>
              <th>AMOUNT</th>
            </tr>
          </thead>
          <tbody>
            <% orders.slice(0,50).forEach(order => { %>
              <tr>
                <td><span class="order-id">#<%= order.orderId %></span></td>
                <td style="font-size:12px;"><%= order.user ? order.user.firstName+' '+order.user.lastName : '—' %></td>
                <td style="font-size:11px;color:var(--muted);white-space:nowrap;"><%= new Date(order.createdAt).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %></td>
                <td style="font-size:11px;color:#aaa;"><%= order.paymentMethod %></td>
                <td><span class="s-chip s-<%= order.orderStatus %>"><%= order.orderStatus %></span></td>
                <td style="color:var(--green);font-size:12px;"><%= order.discount > 0 ? '-₹'+order.discount.toLocaleString('en-IN') : '—' %></td>
                <td style="font-weight:700;color:var(--gold);">₹<%= order.grandTotal.toLocaleString('en-IN') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% if(orders.length > 50) { %>
        <div style="padding:12px 20px;font-size:11px;color:var(--muted);border-top:1px solid var(--border);">Showing 50 of <%= orders.length %> orders. Download PDF/Excel for full report.</div>
      <% } %>
      <% } %>
    </div>

  </div>
</div>

<div class="sidebar-overlay" id="sidebarOverlay2" style="display:none;"></div>

<script>
  const hamburger=document.getElementById('hamburger'),sidebar=document.getElementById('sidebar'),overlay=document.getElementById('sidebarOverlay');
  hamburger?.addEventListener('click',()=>{sidebar.classList.toggle('open');overlay.classList.toggle('active');});
  overlay?.addEventListener('click',()=>{sidebar.classList.remove('open');overlay.classList.remove('active');});

  function toggleCustomDates(val){
    document.getElementById('customDates').style.display = val==='custom' ? 'flex' : 'none';
  }

  // Revenue Chart
  const chartLabels = <%- JSON.stringify(chartData.labels) %>;
  const chartValues = <%- JSON.stringify(chartData.data) %>;
  const ctx = document.getElementById('revenueChart').getContext('2d');
  const maxIdx = chartValues.indexOf(Math.max(...chartValues));

  new Chart(ctx, {
    type: 'bar',
    data: {
      labels: chartLabels,
      datasets: [{
        data: chartValues,
        backgroundColor: chartValues.map((v,i) => i===maxIdx ? 'rgba(196,161,77,0.85)' : 'rgba(196,161,77,0.22)'),
        borderColor:     chartValues.map((v,i) => i===maxIdx ? 'rgba(196,161,77,1)' : 'rgba(196,161,77,0.4)'),
        borderWidth: 1, borderRadius: 2, borderSkipped: false,
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: {
          backgroundColor: '#0a0a0a', borderColor: '#c4a14d', borderWidth: 1,
          titleColor: '#c4a14d', bodyColor: '#fff',
          titleFont: { family: 'Playfair Display', size: 12 },
          bodyFont:  { family: 'Playfair Display', size: 11 },
          padding: 10,
          callbacks: { label: ctx => ' ₹' + ctx.parsed.y.toLocaleString('en-IN') }
        }
      },
      scales: {
        x: { grid: { color: 'rgba(255,255,255,0.04)' }, ticks: { color: '#666', font: { family: 'Playfair Display', size: 9 } }, border: { color: '#1a1a1a' } },
        y: {
          grid: { color: 'rgba(255,255,255,0.04)' },
          ticks: { color: '#555', font: { family: 'Playfair Display', size: 9 }, callback: v => '₹'+(v>=1000?(v/1000).toFixed(0)+'k':v) },
          border: { color: 'transparent' }
        }
      }
    }
  });
</script>
</body>
</html>
