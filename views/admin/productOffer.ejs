<%# views/admin/productOffer.ejs %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Product Offers | Royal Mist Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
  <style>
    :root{--gold:#c4a14d;--gold-dim:rgba(196,161,77,0.12);--bg:#000;--sidebar-bg:#050505;--card:#0a0a0a;--border:#1a1a1a;--text:#fff;--muted:#888;--dim:#555;--sidebar-w:240px;--green:#4caf82;--red:#e05252;--orange:#f39c12;}
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:var(--bg);color:var(--text);font-family:'Playfair Display',serif;min-height:100vh;display:flex;}
    .sidebar{width:var(--sidebar-w);min-height:100vh;background:var(--sidebar-bg);border-right:1px solid #111;display:flex;flex-direction:column;position:fixed;top:0;left:0;z-index:100;transition:transform 0.3s;}
    .sidebar-logo{display:flex;align-items:center;gap:10px;padding:28px 24px 24px;border-bottom:1px solid #111;}
    .logo-icon{width:36px;height:36px;background:var(--gold);clip-path:polygon(0 0,70% 0,100% 30%,100% 100%,30% 100%,0 70%);flex-shrink:0;}
    .logo-text{font-size:13px;font-weight:700;letter-spacing:4px;color:var(--gold);}
    .nav-menu{flex:1;padding:20px 0;overflow-y:auto;}
    .nav-item{display:flex;align-items:center;gap:14px;padding:13px 24px;color:#666;text-decoration:none;font-size:13px;letter-spacing:1px;transition:all 0.2s;border-left:3px solid transparent;}
    .nav-item:hover{color:var(--gold);background:var(--gold-dim);}
    .nav-item.active{color:var(--gold);border-left-color:var(--gold);background:var(--gold-dim);}
    .nav-item i{width:18px;text-align:center;font-size:13px;}
    .sidebar-footer{padding:20px 24px;border-top:1px solid #111;font-size:10px;letter-spacing:2px;color:#333;text-align:center;}
    .main{margin-left:var(--sidebar-w);flex:1;min-height:100vh;display:flex;flex-direction:column;}
    .topbar{display:flex;align-items:center;justify-content:space-between;padding:20px 36px;border-bottom:1px solid #111;background:var(--bg);position:sticky;top:0;z-index:50;flex-wrap:wrap;gap:12px;}
    .topbar-title{font-size:24px;font-weight:700;}
    .hamburger{display:none;background:none;border:1px solid #222;color:var(--muted);padding:7px 10px;cursor:pointer;font-size:16px;}
    .content{padding:28px 36px;flex:1;}
    .stat-row{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:24px;}
    .stat-card{background:var(--card);border:1px solid var(--border);padding:18px 16px;}
    .stat-icon{width:34px;height:34px;background:var(--gold-dim);display:flex;align-items:center;justify-content:center;color:var(--gold);font-size:14px;margin-bottom:12px;}
    .stat-label{font-size:9px;letter-spacing:2px;color:var(--muted);margin-bottom:4px;}
    .stat-value{font-size:22px;font-weight:700;}
    /* FILTER */
    .filter-bar{background:var(--card);border:1px solid var(--border);padding:16px 20px;margin-bottom:20px;display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end;}
    .filter-grp{display:flex;flex-direction:column;gap:6px;}
    .filter-label{font-size:9px;letter-spacing:2px;color:var(--gold);}
    .filter-input,.filter-select{background:#000;border:1px solid #222;color:#fff;font-family:'Playfair Display',serif;font-size:12px;padding:8px 12px;outline:none;transition:border-color 0.2s;}
    .filter-input:focus,.filter-select:focus{border-color:var(--gold);}
    .filter-input::placeholder{color:#444;}
    .filter-select option{background:#111;}
    .btn-search{background:var(--gold);border:none;color:#000;font-family:'Playfair Display',serif;font-size:10px;letter-spacing:2px;font-weight:700;padding:8px 18px;cursor:pointer;align-self:flex-end;}
    .btn-clear{background:transparent;border:1px solid #333;color:#666;font-family:'Playfair Display',serif;font-size:10px;letter-spacing:2px;padding:8px 14px;cursor:pointer;align-self:flex-end;text-decoration:none;display:inline-flex;align-items:center;}
    .btn-clear:hover{border-color:#c0392b;color:#c0392b;}
    /* GRID */
    .products-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px;}
    .product-offer-card{background:var(--card);border:1px solid var(--border);padding:18px;transition:border-color 0.2s;}
    .product-offer-card:hover{border-color:#2a2a2a;}
    .product-offer-card.has-offer{border-color:#1a3a00;}
    .prod-img{width:100%;aspect-ratio:1/1;object-fit:cover;border:1px solid var(--border);margin-bottom:14px;background:#0d0d0d;}
    .prod-name{font-size:14px;font-weight:600;margin-bottom:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .prod-cat{font-size:10px;color:var(--dim);letter-spacing:1px;margin-bottom:10px;}
    .price-row{display:flex;align-items:center;gap:8px;margin-bottom:12px;}
    .original-price{font-size:12px;color:var(--dim);text-decoration:line-through;}
    .discounted-price{font-size:16px;font-weight:700;color:var(--gold);}
    .offer-badge{display:inline-block;background:rgba(76,175,130,0.1);border:1px solid #1a3a1a;color:var(--green);font-size:9px;letter-spacing:1px;padding:3px 8px;margin-bottom:10px;}
    .no-offer-badge{display:inline-block;background:rgba(85,85,85,0.1);border:1px solid #2a2a2a;color:var(--dim);font-size:9px;letter-spacing:1px;padding:3px 8px;margin-bottom:10px;}
    .card-actions{display:flex;gap:7px;flex-wrap:wrap;}
    .btn-set{background:var(--gold);border:none;color:#000;font-family:'Playfair Display',serif;font-size:9px;letter-spacing:1px;font-weight:700;padding:7px 14px;cursor:pointer;transition:0.2s;}
    .btn-set:hover{background:#b38f3d;}
    .btn-toggle-on{background:transparent;border:1px solid #1a3a1a;color:var(--green);font-family:'Playfair Display',serif;font-size:9px;letter-spacing:1px;padding:7px 12px;cursor:pointer;transition:0.2s;}
    .btn-toggle-on:hover{background:rgba(76,175,130,0.1);}
    .btn-toggle-off{background:transparent;border:1px solid #3a1a00;color:var(--orange);font-family:'Playfair Display',serif;font-size:9px;letter-spacing:1px;padding:7px 12px;cursor:pointer;transition:0.2s;}
    .btn-toggle-off:hover{background:rgba(243,156,18,0.1);}
    .btn-remove-offer{background:transparent;border:1px solid #3a1a1a;color:var(--red);font-family:'Playfair Display',serif;font-size:9px;letter-spacing:1px;padding:7px 12px;cursor:pointer;transition:0.2s;}
    .btn-remove-offer:hover{background:rgba(224,82,82,0.1);}
    /* PAGINATION */
    .pagination-wrap{display:flex;justify-content:space-between;align-items:center;padding:20px 0;flex-wrap:wrap;gap:10px;}
    .page-info{font-size:11px;color:var(--muted);}
    .page-btns{display:flex;gap:6px;}
    .page-btn{background:transparent;border:1px solid #2a2a2a;color:#666;font-family:'Playfair Display',serif;font-size:11px;padding:6px 12px;cursor:pointer;transition:0.2s;text-decoration:none;display:inline-block;}
    .page-btn:hover{border-color:var(--gold);color:var(--gold);}
    .page-btn.active{border-color:var(--gold);color:var(--gold);background:var(--gold-dim);}
    .page-btn.disabled{opacity:0.3;pointer-events:none;}
    /* MODAL */
    .modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.92);z-index:2000;align-items:center;justify-content:center;padding:20px;}
    .modal-overlay.active{display:flex;}
    .modal-box{background:#0a0a0a;border:1px solid #2a2a2a;width:100%;max-width:480px;animation:modalIn 0.25s ease;}
    @keyframes modalIn{from{transform:translateY(20px);opacity:0;}to{transform:translateY(0);opacity:1;}}
    .modal-head{padding:20px 26px;border-bottom:1px solid #1a1a1a;display:flex;justify-content:space-between;align-items:center;}
    .modal-title{font-size:11px;letter-spacing:3px;color:var(--gold);}
    .modal-close{background:none;border:1px solid #2a2a2a;color:#666;width:28px;height:28px;cursor:pointer;font-size:12px;display:flex;align-items:center;justify-content:center;}
    .modal-close:hover{border-color:var(--gold);color:var(--gold);}
    .modal-body{padding:22px 26px;}
    .modal-prod-name{font-size:14px;font-weight:600;margin-bottom:4px;}
    .modal-prod-price{font-size:11px;color:var(--muted);margin-bottom:18px;}
    .form-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;}
    .form-row.full{grid-template-columns:1fr;}
    .form-grp{display:flex;flex-direction:column;gap:6px;}
    .form-grp label{font-size:9px;letter-spacing:2px;color:var(--gold);}
    .form-grp input,.form-grp select{background:#000;border:1px solid #222;color:#fff;font-family:'Playfair Display',serif;font-size:13px;padding:9px 12px;outline:none;transition:border-color 0.2s;appearance:none;}
    .form-grp input:focus,.form-grp select:focus{border-color:var(--gold);}
    .form-grp input::placeholder{color:#333;}
    .form-grp select option{background:#111;}
    .preview-box{background:#000;border:1px solid #1a3a1a;padding:12px 16px;margin-bottom:16px;font-size:12px;display:none;}
    .preview-box.show{display:block;}
    .modal-footer{padding:14px 26px;border-top:1px solid #1a1a1a;display:flex;gap:10px;justify-content:flex-end;}
    .btn-save{background:var(--gold);border:none;color:#000;font-family:'Playfair Display',serif;font-size:10px;letter-spacing:2px;font-weight:700;padding:10px 22px;cursor:pointer;}
    .btn-save:hover{background:#b38f3d;}
    .btn-cancel-modal{background:transparent;border:1px solid #2a2a2a;color:#666;font-family:'Playfair Display',serif;font-size:10px;letter-spacing:2px;padding:10px 18px;cursor:pointer;}
    .btn-cancel-modal:hover{color:#fff;border-color:#555;}
    .toast-msg{position:fixed;bottom:28px;right:24px;background:#0a0a0a;border:1px solid var(--gold);color:var(--gold);font-size:12px;letter-spacing:1px;padding:12px 20px;z-index:9999;display:none;}
    .toast-msg.error{border-color:var(--red);color:var(--red);}
    .sidebar-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:99;}
    .sidebar-overlay.active{display:block;}
    .empty-state{text-align:center;padding:60px 20px;color:var(--dim);}
    @media(max-width:900px){.main{margin-left:0;}.sidebar{transform:translateX(-100%);}.sidebar.open{transform:translateX(0);}.hamburger{display:flex;align-items:center;}.content{padding:16px;}.topbar{padding:16px;}.stat-row{grid-template-columns:1fr 1fr;}.form-row{grid-template-columns:1fr;}.products-grid{grid-template-columns:repeat(auto-fill,minmax(200px,1fr));}}
  </style>
</head>
<body>
<div class="sidebar-overlay" id="sidebarOverlay"></div>
<aside class="sidebar" id="sidebar">
  <div class="sidebar-logo"><div class="logo-icon"></div><span class="logo-text">ROYALMIST</span></div>
  <nav class="nav-menu">
    <a class="nav-item" href="/admin/dashboard"><i class="fa-solid fa-border-all"></i><span>Dashboard</span></a>
    <a class="nav-item" href="/admin/products"><i class="fa-solid fa-box-open"></i><span>Products</span></a>
    <a class="nav-item" href="/admin/categories"><i class="fa-solid fa-tag"></i><span>Categories</span></a>
    <a class="nav-item" href="/admin/coupons"><i class="fa-solid fa-ticket"></i><span>Coupons</span></a>
    <a class="nav-item" href="/admin/customers"><i class="fa-solid fa-users"></i><span>Customers</span></a>
    <a class="nav-item" href="/admin/orders"><i class="fa-solid fa-bag-shopping"></i><span>Orders</span></a>
    <a class="nav-item" href="/admin/inventory"><i class="fa-solid fa-warehouse"></i><span>Inventory</span></a>
    <a class="nav-item active" href="/admin/product-offer"><i class="fa-solid fa-percent"></i><span>Product Offer</span></a>
    <a class="nav-item" href="/admin/category-offer"><i class="fa-solid fa-layer-group"></i><span>Category Offer</span></a>
    <a class="nav-item" href="/admin/sales-report"><i class="fa-solid fa-chart-bar"></i><span>Sales Report</span></a>
    <a class="nav-item" href="/admin/logout"><i class="fa-solid fa-right-from-bracket"></i><span>Logout</span></a>
  </nav>
  <div class="sidebar-footer">ROYALMIST ADMIN v2.0</div>
</aside>

<div class="main">
  <div class="topbar">
    <div style="display:flex;align-items:center;gap:14px;">
      <button class="hamburger" id="hamburger"><i class="fas fa-bars"></i></button>
      <h1 class="topbar-title">Product Offers</h1>
    </div>
    <div style="font-size:11px;color:var(--muted);"><%= stats.withOffer %> products with active offers</div>
  </div>

  <div class="content">
    <!-- STATS -->
    <div class="stat-row">
      <div class="stat-card"><div class="stat-icon"><i class="fas fa-box"></i></div><div class="stat-label">Total Products</div><div class="stat-value"><%= stats.total %></div></div>
      <div class="stat-card" style="border-color:#1a3a00;"><div class="stat-icon" style="background:rgba(76,175,130,0.1);color:var(--green);"><i class="fas fa-tag"></i></div><div class="stat-label">With Offer</div><div class="stat-value" style="color:var(--green);"><%= stats.withOffer %></div></div>
      <div class="stat-card"><div class="stat-icon"><i class="fas fa-box-open"></i></div><div class="stat-label">No Offer</div><div class="stat-value"><%= stats.withoutOffer %></div></div>
    </div>

    <!-- FILTERS -->
    <form method="GET" action="/admin/product-offer">
      <div class="filter-bar">
        <div class="filter-grp"><span class="filter-label">Search</span><input class="filter-input" name="search" value="<%= filters.search %>" placeholder="Product name..." style="width:200px;"/></div>
        <div class="filter-grp"><span class="filter-label">Filter</span>
          <select class="filter-select" name="filter">
            <option value="all"      <%= filters.filter==='all'      ?'selected':'' %>>All Products</option>
            <option value="active"   <%= filters.filter==='active'   ?'selected':'' %>>With Active Offer</option>
            <option value="inactive" <%= filters.filter==='inactive' ?'selected':'' %>>Without Offer</option>
          </select>
        </div>
        <button type="submit" class="btn-search"><i class="fas fa-search me-1"></i>SEARCH</button>
        <% if(filters.search||filters.filter!=='all') { %><a href="/admin/product-offer" class="btn-clear"><i class="fas fa-times me-1"></i>CLEAR</a><% } %>
      </div>
    </form>

    <!-- PRODUCTS GRID -->
    <% if(products.length === 0) { %>
      <div class="empty-state"><i class="fas fa-box-open" style="font-size:40px;color:#1a1a1a;margin-bottom:16px;display:block;"></i><p>NO PRODUCTS FOUND</p></div>
    <% } else { %>
    <div class="products-grid">
      <% products.forEach(product => { %>
        <%
          const hasOffer = product.offer && product.offer.isActive && product.offer.discountValue > 0;
          const basePrice = product.volumes?.[0]?.price || 0;
          let discountedPrice = basePrice;
          if(product.offer && product.offer.discountValue > 0) {
            if(product.offer.discountType === 'percentage') {
              discountedPrice = Math.max(0, basePrice - Math.round((basePrice * product.offer.discountValue)/100));
            } else {
              discountedPrice = Math.max(0, basePrice - product.offer.discountValue);
            }
          }
        %>
        <div class="product-offer-card <%= hasOffer ? 'has-offer' : '' %>" id="card-<%= product._id %>">
          <img src="<%= product.images?.[0] || '/images/placeholder.jpg' %>" class="prod-img" alt="<%= product.name %>" onerror="this.style.display='none'"/>
          <div class="prod-name"><%= product.name %></div>
          <div class="prod-cat"><%= product.category?.name || '—' %> · <%= product.fragranceType %></div>

          <% if(hasOffer) { %>
            <span class="offer-badge"><i class="fas fa-tag me-1"></i><%= product.offer.offerLabel || (product.offer.discountType==='percentage' ? product.offer.discountValue+'% OFF' : '₹'+product.offer.discountValue+' OFF') %></span>
            <div class="price-row">
              <span class="original-price">₹<%= basePrice.toLocaleString('en-IN') %></span>
              <span class="discounted-price">₹<%= discountedPrice.toLocaleString('en-IN') %></span>
            </div>
          <% } else { %>
            <span class="no-offer-badge">NO OFFER</span>
            <div class="price-row"><span class="discounted-price">₹<%= basePrice.toLocaleString('en-IN') %></span></div>
          <% } %>

          <div class="card-actions">
            <button class="btn-set" onclick="openOfferModal('<%= product._id %>')">
              <i class="fas fa-pen me-1"></i><%= hasOffer ? 'EDIT' : 'SET OFFER' %>
            </button>
            <% if(product.offer && product.offer.discountValue > 0) { %>
              <button class="<%= hasOffer ? 'btn-toggle-off' : 'btn-toggle-on' %>"
                onclick="toggleOffer('<%= product._id %>', '<%= hasOffer %>')" id="toggle-<%= product._id %>">
                <%= hasOffer ? 'PAUSE' : 'ACTIVATE' %>
              </button>
              <button class="btn-remove-offer" onclick="removeOffer('<%= product._id %>')">
                <i class="fas fa-times"></i>
              </button>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>

    <!-- PAGINATION -->
    <% if(totalPages > 1) { %>
      <div class="pagination-wrap">
        <span class="page-info">Page <%= currentPage %> of <%= totalPages %></span>
        <div class="page-btns">
          <a href="?<%= new URLSearchParams({...filters,page:currentPage-1}).toString() %>" class="page-btn <%= currentPage<=1?'disabled':'' %>"><i class="fas fa-chevron-left" style="font-size:9px;"></i></a>
          <% for(let p=Math.max(1,currentPage-2);p<=Math.min(totalPages,currentPage+2);p++){ %>
            <a href="?<%= new URLSearchParams({...filters,page:p}).toString() %>" class="page-btn <%= p===currentPage?'active':'' %>"><%= p %></a>
          <% } %>
          <a href="?<%= new URLSearchParams({...filters,page:currentPage+1}).toString() %>" class="page-btn <%= currentPage>=totalPages?'disabled':'' %>"><i class="fas fa-chevron-right" style="font-size:9px;"></i></a>
        </div>
      </div>
    <% } %>
    <% } %>
  </div>
</div>

<!-- OFFER MODAL -->
<div class="modal-overlay" id="offerModal">
  <div class="modal-box">
    <div class="modal-head">
      <span class="modal-title">SET PRODUCT OFFER</span>
      <button class="modal-close" onclick="closeModal()"><i class="fas fa-times"></i></button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="editProductId"/>
      <div class="modal-prod-name" id="modalProdName"></div>
      <div class="modal-prod-price" id="modalProdPrice"></div>
      <div class="form-row">
        <div class="form-grp"><label>DISCOUNT TYPE *</label>
          <select id="fDiscType" onchange="updatePreview()">
            <option value="percentage">Percentage (%)</option>
            <option value="flat">Flat Amount (₹)</option>
          </select>
        </div>
        <div class="form-grp"><label>DISCOUNT VALUE *</label>
          <input type="number" id="fDiscValue" placeholder="e.g. 20" min="1" oninput="updatePreview()"/>
        </div>
      </div>
      <div class="preview-box" id="previewBox">
        <span style="font-size:10px;color:var(--muted);letter-spacing:1px;">PREVIEW: </span>
        <span id="previewText" style="color:var(--green);font-weight:600;"></span>
      </div>
      <div class="form-row full">
        <div class="form-grp"><label>OFFER LABEL <span style="color:var(--dim);font-size:9px;">Optional</span></label>
          <input type="text" id="fLabel" placeholder="e.g. Summer Sale" maxlength="40"/>
        </div>
      </div>
      <div class="form-row">
        <div class="form-grp"><label>START DATE <span style="color:var(--dim);font-size:9px;">Optional</span></label>
          <input type="date" id="fStart"/>
        </div>
        <div class="form-grp"><label>END DATE <span style="color:var(--dim);font-size:9px;">Optional</span></label>
          <input type="date" id="fEnd"/>
        </div>
      </div>
      <div class="form-row full">
        <div class="form-grp" style="flex-direction:row;align-items:center;gap:12px;">
          <input type="checkbox" id="fActive" style="width:16px;height:16px;cursor:pointer;accent-color:var(--gold);" checked/>
          <label for="fActive" style="font-size:12px;color:#aaa;cursor:pointer;letter-spacing:1px;">Activate offer immediately</label>
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn-cancel-modal" onclick="closeModal()">CANCEL</button>
      <button class="btn-save" id="saveOfferBtn" onclick="saveOffer()"><i class="fas fa-check me-1"></i>SAVE OFFER</button>
    </div>
  </div>
</div>

<div class="toast-msg" id="toastMsg"></div>

<script>
  const hamburger=document.getElementById('hamburger'),sidebar=document.getElementById('sidebar'),overlay=document.getElementById('sidebarOverlay');
  hamburger?.addEventListener('click',()=>{sidebar.classList.toggle('open');overlay.classList.toggle('active');});
  overlay?.addEventListener('click',()=>{sidebar.classList.remove('open');overlay.classList.remove('active');});
  function showToast(msg,isError=false){const t=document.getElementById('toastMsg');t.textContent=msg;t.className='toast-msg'+(isError?' error':'');t.style.display='block';setTimeout(()=>t.style.display='none',3000);}

  let currentBasePrice = 0;

  async function openOfferModal(id){
    try{
      const res=await fetch(`/admin/product-offer/${id}`);
      const data=await res.json();
      if(!data.success){showToast('Failed to load',true);return;}
      const p=data.product;
      currentBasePrice = p.volumes?.[0]?.price || 0;
      document.getElementById('editProductId').value=id;
      document.getElementById('modalProdName').textContent=p.name;
      document.getElementById('modalProdPrice').textContent='Base price: ₹'+currentBasePrice.toLocaleString('en-IN');
      document.getElementById('fDiscType').value=p.offer?.discountType||'percentage';
      document.getElementById('fDiscValue').value=p.offer?.discountValue||'';
      document.getElementById('fLabel').value=p.offer?.offerLabel||'';
      document.getElementById('fStart').value=p.offer?.startDate?new Date(p.offer.startDate).toISOString().split('T')[0]:'';
      document.getElementById('fEnd').value=p.offer?.endDate?new Date(p.offer.endDate).toISOString().split('T')[0]:'';
      document.getElementById('fActive').checked=p.offer?.isActive!==false;
      updatePreview();
      document.getElementById('offerModal').classList.add('active');
    }catch{showToast('Something went wrong',true);}
  }

  function updatePreview(){
    const type=document.getElementById('fDiscType').value;
    const val=parseFloat(document.getElementById('fDiscValue').value);
    const box=document.getElementById('previewBox');
    const txt=document.getElementById('previewText');
    if(!val||!currentBasePrice){box.classList.remove('show');return;}
    let disc=type==='percentage'?Math.round(currentBasePrice*val/100):val;
    disc=Math.min(disc,currentBasePrice);
    const final=currentBasePrice-disc;
    txt.textContent=`₹${currentBasePrice.toLocaleString('en-IN')} → ₹${final.toLocaleString('en-IN')} (Save ₹${disc.toLocaleString('en-IN')})`;
    box.classList.add('show');
  }

  function closeModal(){document.getElementById('offerModal').classList.remove('active');}

  async function saveOffer(){
    const id=document.getElementById('editProductId').value;
    const discountType=document.getElementById('fDiscType').value;
    const discountValue=document.getElementById('fDiscValue').value;
    if(!discountValue){showToast('Enter discount value',true);return;}
    const btn=document.getElementById('saveOfferBtn');
    btn.disabled=true;btn.textContent='SAVING...';
    try{
      const res=await fetch(`/admin/product-offer/${id}`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({
        discountType,discountValue,
        offerLabel:document.getElementById('fLabel').value,
        startDate:document.getElementById('fStart').value,
        endDate:document.getElementById('fEnd').value,
        isActive:document.getElementById('fActive').checked,
      })});
      const data=await res.json();
      if(data.success){showToast(data.message);closeModal();setTimeout(()=>location.reload(),1200);}
      else showToast(data.message||'Failed',true);
    }catch{showToast('Something went wrong',true);}
    finally{btn.disabled=false;btn.innerHTML='<i class="fas fa-check me-1"></i>SAVE OFFER';}
  }

  async function toggleOffer(id,isActive){
    try{
      const res=await fetch(`/admin/product-offer/${id}/toggle`,{method:'PATCH'});
      const data=await res.json();
      if(data.success){showToast(data.message);setTimeout(()=>location.reload(),1000);}
      else showToast(data.message||'Failed',true);
    }catch{showToast('Something went wrong',true);}
  }

  async function removeOffer(id){
    if(!confirm('Remove this offer?'))return;
    try{
      const res=await fetch(`/admin/product-offer/${id}`,{method:'DELETE'});
      const data=await res.json();
      if(data.success){showToast(data.message);setTimeout(()=>location.reload(),1000);}
      else showToast(data.message||'Failed',true);
    }catch{showToast('Something went wrong',true);}
  }

  document.getElementById('offerModal').addEventListener('click',function(e){if(e.target===this)closeModal();});
</script>
</body>
</html>
