<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Category Management — RoyalMist Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
:root {
  --gold: #c4a14d;
  --gold-light: #d4b05d;
  --bg: #000;
  --sidebar-bg: #050505;
  --card: #0a0a0a;
  --border: #1a1a1a;
  --border-dim: #111;
  --text: #fff;
  --text-muted: #888;
  --sidebar-width: 240px;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body { background: var(--bg); color: var(--text); font-family: 'Playfair Display', serif; min-height: 100vh; display: flex; }

/* ── SIDEBAR ── */
.sidebar {
  width: var(--sidebar-width); background: var(--sidebar-bg);
  border-right: 1px solid var(--border); display: flex; flex-direction: column;
  position: fixed; top: 0; left: 0; height: 100vh; z-index: 100; transition: transform 0.3s ease;
}
.sidebar-logo { padding: 28px 24px 24px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 12px; }
.logo-icon {
  width: 36px; height: 36px; background: var(--gold);
  display: flex; align-items: center; justify-content: center; font-size: 18px;
  clip-path: polygon(0 0, 70% 0, 100% 30%, 100% 100%, 30% 100%, 0 70%); flex-shrink: 0;
}
.logo-text { color: var(--gold); font-size: 13px; letter-spacing: 4px; font-weight: 700; }
.sidebar-nav { flex: 1; padding: 20px 0; overflow-y: auto; }
.nav-item {
  display: flex; align-items: center; gap: 14px; padding: 13px 24px;
  color: #666; text-decoration: none; font-size: 13px; letter-spacing: 1px;
  transition: all 0.2s; cursor: pointer; border-left: 3px solid transparent;
}
.nav-item:hover { color: var(--gold); background: rgba(196,161,77,0.15); }
.nav-item.active { color: var(--gold); border-left-color: var(--gold); background: rgba(196,161,77,0.05); }
.nav-item i { width: 18px; font-size: 14px; text-align: center; }
.sidebar-footer { padding: 20px 24px; border-top: 1px solid var(--border); font-size: 10px; letter-spacing: 2px; color: #333; text-align: center; }

/* ── MAIN ── */
.main-content { margin-left: var(--sidebar-width); flex: 1; min-height: 100vh; display: flex; flex-direction: column; }
.top-bar {
  border-bottom: 1px solid var(--border); padding: 20px 36px;
  display: flex; align-items: center; justify-content: space-between; gap: 16px;
  background: rgba(0,0,0,0.8); backdrop-filter: blur(10px); position: sticky; top: 0; z-index: 50;
}
.page-heading { font-size: 28px; font-weight: 700; letter-spacing: 2px; }
.btn-add {
  border: 1px solid var(--gold); color: #000; background: var(--gold);
  padding: 10px 22px; font-size: 11px; letter-spacing: 2px;
  font-family: 'Playfair Display', serif; font-weight: 700; cursor: pointer; transition: 0.3s;
  white-space: nowrap; text-decoration: none; display: inline-flex; align-items: center; gap: 8px;
}
.btn-add:hover { background: var(--gold-light); border-color: var(--gold-light); }

.content-wrap { padding: 36px; flex: 1; }
.table-card { border: 1px solid var(--border); background: var(--card); }
.table-header {
  padding: 28px 32px 20px; display: flex; align-items: flex-start;
  justify-content: space-between; flex-wrap: wrap; gap: 16px; border-bottom: 1px solid var(--border-dim);
}
.table-title { font-size: 13px; letter-spacing: 4px; color: var(--gold); font-weight: 600; line-height: 1.4; }
.table-subtitle { font-size: 12px; color: var(--text-muted); letter-spacing: 1px; margin-top: 6px; }

/* ── SEARCH ── */
.search-wrap { position: relative; display: flex; align-items: center; }
.search-wrap input {
  background: #050505; border: 1px solid #2a2a2a; color: #fff;
  padding: 11px 40px 11px 42px; font-family: 'Playfair Display', serif;
  font-size: 12px; letter-spacing: 1px; outline: none; width: 280px; transition: border-color 0.2s;
}
.search-wrap input:focus { border-color: var(--gold); }
.search-wrap input::placeholder { color: #444; }
.search-icon { position: absolute; left: 14px; color: #444; font-size: 13px; pointer-events: none; transition: color 0.2s; }
.search-wrap:focus-within .search-icon { color: var(--gold); }
.search-clear {
  position: absolute; right: 12px; background: none; border: none; color: #555;
  font-size: 14px; cursor: pointer; display: none; line-height: 1; transition: color 0.2s; padding: 2px 4px;
}
.search-clear:hover { color: var(--gold); }
.search-clear.visible { display: flex; align-items: center; }

/* ── TABLE ── */
.categories-table { width: 100%; border-collapse: collapse; }
.categories-table thead tr { border-bottom: 1px solid var(--border-dim); }
.categories-table th { padding: 16px 20px; text-align: left; font-size: 10px; letter-spacing: 3px; color: var(--gold); font-weight: 700; }
.categories-table tbody tr { border-bottom: 1px solid #0d0d0d; transition: background 0.2s; }
.categories-table tbody tr:hover { background: #0d0d0d; }
.categories-table td { padding: 20px; font-size: 13px; vertical-align: middle; }
.td-no { color: var(--text-muted); font-size: 11px; letter-spacing: 2px; width: 55px; }
.cat-name { font-size: 15px; letter-spacing: 1px; font-weight: 600; }
.cat-desc { font-size: 12px; color: #aaa; letter-spacing: 0.3px; line-height: 1.6; max-width: 280px; }
.cat-date { font-size: 11px; color: var(--text-muted); letter-spacing: 0.5px; white-space: nowrap; }

/* ── ACTIONS ── */
.action-cell { display: flex; gap: 8px; align-items: center; justify-content: flex-end; flex-wrap: wrap; }
.btn-action {
  padding: 8px 16px; border: 1px solid; font-family: 'Playfair Display', serif;
  font-size: 10px; letter-spacing: 2px; font-weight: 700; cursor: pointer;
  transition: all 0.2s; text-decoration: none; display: inline-flex;
  align-items: center; gap: 6px; white-space: nowrap; background: transparent;
}
.btn-edit { border-color: #2a2a2a; color: #888; }
.btn-edit:hover { border-color: var(--gold); color: var(--gold); }
.btn-list { border-color: var(--gold); color: var(--gold); }
.btn-list:hover { background: var(--gold); color: #000; }

/* ── EMPTY STATE ── */
.empty-state { padding: 60px 20px; text-align: center; color: var(--text-muted); }
.empty-state i { font-size: 36px; color: #2a2a2a; margin-bottom: 16px; display: block; }
.empty-state p { font-size: 12px; letter-spacing: 2px; }

/* ── FOOTER / PAGINATION ── */
.table-footer {
  padding: 22px 32px; display: flex; align-items: center;
  justify-content: space-between; flex-wrap: wrap; gap: 14px; border-top: 1px solid var(--border-dim);
}
.count-text { font-size: 10px; letter-spacing: 3px; color: var(--text-muted); }
.pagination { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
.page-btn {
  width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;
  background: transparent; border: 1px solid #2a2a2a; color: #666;
  font-family: 'Playfair Display', serif; font-size: 12px; cursor: pointer; transition: all 0.2s; text-decoration: none;
}
.page-btn:hover { border-color: var(--gold); color: var(--gold); }
.page-btn.active { background: var(--gold); border-color: var(--gold); color: #000; font-weight: 700; }
.page-btn.disabled { opacity: 0.3; pointer-events: none; }

/* ── STATS ── */
.stats-strip { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--border); border-top: none; }
.stat-box { padding: 28px 36px; border-right: 1px solid var(--border); }
.stat-box:last-child { border-right: none; }
.stat-label { font-size: 10px; letter-spacing: 3px; color: var(--text-muted); margin-bottom: 10px; }
.stat-value { font-size: 32px; font-weight: 700; color: var(--gold); letter-spacing: 2px; }

.admin-footer { padding: 24px 36px; border-top: 1px solid var(--border-dim); text-align: center; font-size: 10px; letter-spacing: 3px; color: #2a2a2a; }

/* ── TOAST ── */
#toast {
  display: none; position: fixed; top: 24px; left: 50%; transform: translateX(-50%);
  background: #000; border: 1px solid var(--gold); color: var(--gold);
  padding: 14px 28px; font-family: 'Playfair Display', serif;
  font-size: 12px; letter-spacing: 2px; z-index: 9999; max-width: 90vw; text-align: center;
}

/* ── HAMBURGER ── */
.hamburger {
  display: none; background: none; border: 1px solid #2a2a2a; color: var(--gold);
  width: 38px; height: 38px; cursor: pointer; align-items: center; justify-content: center;
  font-size: 16px; transition: 0.2s; flex-shrink: 0;
}
.hamburger:hover { border-color: var(--gold); }
.sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); z-index: 99; }


.btn-delete { border-color: #2a2a2a; color: #888; }
.btn-delete:hover { border-color: #c0392b; color: #c0392b; }

/* ── CONFIRM MODAL ── */
.confirm-overlay {
  display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85);
  z-index: 8888; align-items: center; justify-content: center;
}
.confirm-overlay.active { display: flex; }
.confirm-box {
  background: #0a0a0a; border: 1px solid #1a1a1a;
  padding: 40px 44px; max-width: 420px; width: 90%; text-align: center;
}
.confirm-icon { font-size: 36px; color: #c0392b; margin-bottom: 18px; }
.confirm-title { font-size: 14px; letter-spacing: 3px; color: var(--gold); margin-bottom: 10px; }
.confirm-msg { font-size: 12px; color: #888; letter-spacing: 1px; margin-bottom: 28px; line-height: 1.7; }
.confirm-actions { display: flex; gap: 12px; justify-content: center; }
.btn-cancel-confirm {
  padding: 10px 24px; border: 1px solid #2a2a2a; color: #888; background: transparent;
  font-family: 'Playfair Display', serif; font-size: 10px; letter-spacing: 2px; cursor: pointer; transition: 0.2s;
}
.btn-cancel-confirm:hover { border-color: var(--gold); color: var(--gold); }
.btn-confirm-delete {
  padding: 10px 24px; border: 1px solid #c0392b; color: #c0392b; background: transparent;
  font-family: 'Playfair Display', serif; font-size: 10px; letter-spacing: 2px; cursor: pointer; transition: 0.2s;
}
.btn-confirm-delete:hover { background: #c0392b; color: #fff; }





/* ── EDIT MODAL ── */
#editOverlay {
  display: none; position: fixed; inset: 0;
  background: rgba(0,0,0,0.88); z-index: 200;
  align-items: center; justify-content: center;
  backdrop-filter: blur(4px);
}
#editOverlay.active { display: flex; }
.edit-modal {
  background: var(--card); border: 1px solid var(--border);
  width: 100%; max-width: 520px; margin: 20px;
  animation: modalIn 0.2s ease;
}
@keyframes modalIn {
  from { opacity:0; transform:translateY(-16px); }
  to   { opacity:1; transform:translateY(0); }
}
.edit-modal-header {
  padding: 26px 30px 20px; border-bottom: 1px solid var(--border-dim); position: relative;
}
.edit-modal-body { padding: 28px 30px; }
.modal-close {
  position: absolute; top: 20px; right: 20px;
  background: none; border: 1px solid #2a2a2a; color: #666;
  width: 30px; height: 30px; cursor: pointer; font-size: 13px;
  display: flex; align-items: center; justify-content: center; transition: 0.2s;
}
.modal-close:hover { border-color: var(--gold); color: var(--gold); }
.field { margin-bottom: 24px; }
.field label { display:block; font-size:10px; letter-spacing:3px; color:var(--gold); font-weight:700; margin-bottom:10px; }
.field input, .field textarea {
  width:100%; background:#050505; border:1px solid #2a2a2a; color:#fff;
  padding:13px 16px; font-family:'Playfair Display',serif; font-size:13px;
  outline:none; transition:border-color 0.2s; resize:vertical;
}
.field input:focus, .field textarea:focus { border-color: var(--gold); }
.field input::placeholder, .field textarea::placeholder { color: #444; }
.field-error { font-size:11px; color:#c0392b; letter-spacing:1px; margin-top:6px; display:none; }
.field-error.visible { display:block; }
.form-actions { display:flex; gap:12px; justify-content:flex-end; padding-top:8px; }

/* ── RESPONSIVE ── */
@media (max-width: 1024px) {
  .categories-table th:nth-child(3), .categories-table td:nth-child(3) { display: none; }
}
@media (max-width: 900px) {
  .sidebar { transform: translateX(-100%); }
  .sidebar.open { transform: translateX(0); }
  .sidebar-overlay.active { display: block; }
  .main-content { margin-left: 0; }
  .hamburger { display: flex; }
  .top-bar { padding: 16px 20px; }
  .page-heading { font-size: 22px; }
  .content-wrap { padding: 20px 16px; }
  .table-header { padding: 20px 20px 16px; flex-direction: column; align-items: stretch; }
  .search-wrap, .search-wrap input { width: 100%; }
  .categories-table th:nth-child(4), .categories-table td:nth-child(4) { display: none; }
  .table-footer { padding: 16px 20px; flex-direction: column; align-items: flex-start; }
}
@media (max-width: 600px) {
  .page-heading { font-size: 18px; }
  .categories-table th, .categories-table td { padding: 12px 8px; }
  .categories-table th:nth-child(1), .categories-table td:nth-child(1) { display: none; }
  .btn-action { padding: 7px 10px; font-size: 9px; letter-spacing: 1px; }
  .action-cell { gap: 5px; }
  .stat-box { padding: 20px; }
  .stat-value { font-size: 22px; }
  .btn-add { padding: 9px 14px; font-size: 10px; letter-spacing: 1px; }
}
@media (max-width: 400px) {
  .content-wrap { padding: 12px 8px; }
  .page-btn { width: 30px; height: 30px; font-size: 11px; }
  .pagination { gap: 4px; }
  .table-footer { padding: 12px 10px; }
}
</style>
</head>
<body>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<aside class="sidebar" id="sidebar">
   <div class="sidebar-logo">
        <span class="logo-text"><i class="fas fa-gem me-2" style="color:var(--gold)"></i>ROYALMIST</span>
    </div>
 <nav class="sidebar-nav">
    <a class="nav-item" href="/admin/dashboard"><i class="fa-solid fa-border-all"></i>Dashboard</a>
    <a class="nav-item" href="/admin/products"><i class="fa-solid fa-box-open"></i>Products</a>
    <a class="nav-item active" href="/admin/categories"><i class="fa-solid fa-tag"></i>Categories</a>
    <a class="nav-item" href="/admin/coupons"><i class="fa-solid fa-ticket"></i>Coupons</a>
    <a class="nav-item" href="/admin/customers"><i class="fa-solid fa-users"></i>Customers</a>
    <a class="nav-item" href="/admin/orders"><i class="fa-solid fa-bag-shopping"></i>Orders</a>
    <a class="nav-item" href="/admin/inventory"><i class="fa-solid fa-warehouse"></i>Inventory</a>
    <a class="nav-item" href="/admin/product-offer"><i class="fa-solid fa-percent"></i>Product Offer</a>
    <a class="nav-item" href="/admin/category-offer"><i class="fa-solid fa-layer-group"></i>Category Offer</a>
    <a class="nav-item" href="/admin/sales-report"><i class="fa-solid fa-chart-bar"></i>Sales Report</a>
    <a class="nav-item" href="/admin/logout"><i class="fa-solid fa-right-from-bracket"></i>Logout</a>
</nav>
  <div class="sidebar-footer">ROYALMIST ADMIN v2.0</div>
</aside>

<div class="main-content">
  <div class="top-bar">
    <div style="display:flex;align-items:center;gap:14px;">
      <button class="hamburger" id="hamburger"><i class="fa-solid fa-bars"></i></button>
      <h1 class="page-heading">Categories</h1>
    </div>
    <a href="/admin/categories/add" class="btn-add">
      <i class="fa-solid fa-plus" style="font-size:10px;"></i>
      ADD CATEGORY
    </a>
  </div>

  <div class="content-wrap">
    <div class="table-card">

      <div class="table-header">
        <div>
          <div class="table-title">CATEGORY<br>MANAGEMENT</div>
          <div class="table-subtitle">Manage your product classifications and collections.</div>
        </div>
        <form method="GET" action="/admin/categories" id="searchForm">
          <div class="search-wrap">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input
              type="text"
              name="search"
              id="searchInput"
              placeholder="Search categories..."
              value="<%= search %>"
              autocomplete="off"
            >
            <button type="button" class="search-clear <%= search ? 'visible' : '' %>" id="clearBtn">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>
        </form>
      </div>

      <div style="overflow-x:auto;">
        <% if (categories.length === 0) { %>
          <div class="empty-state">
            <i class="fa-solid fa-tag"></i>
            <p>NO CATEGORIES FOUND</p>
          </div>
        <% } else { %>
        <table class="categories-table">
          <thead>
            <tr>
              <th>No.</th>
              <th>Category Name</th>
              <th>Description</th>
              <th>Date</th>
              <th style="text-align:right;">Action</th>
            </tr>
          </thead>
          <tbody>
            <% categories.forEach(function(category, i) { %>
              <% const no = String((currentPage - 1) * pageSize + i + 1).padStart(2, '0'); %>
              <tr>
                <td class="td-no"><%= no %></td>
                <td>
                  <div class="cat-name"><%= category.name %></div>
                </td>
                <td>
                  <div class="cat-desc"><%= category.description || '—' %></div>
                </td>
                <td>
                  <div class="cat-date">
                    <%= new Date(category.createdAt).toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' }) %>
                  </div>
                </td>
                <td>
                <div class="action-cell">
 <button
  class="btn-action btn-edit"
  onclick="openEditModal('<%= category._id %>', '<%= category.name %>', `<%= category.description || '' %>`)"
>
  <i class="fa-solid fa-pen" style="font-size:9px;"></i> EDIT
</button>
  <button
    class="btn-action btn-delete"
    onclick="confirmDelete('<%= category._id %>', '<%= category.name %>')"
  >
    <i class="fa-solid fa-trash" style="font-size:9px;"></i> DELETE
  </button>
</div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <% } %>
      </div>

      <div class="table-footer">
        <div class="count-text">SHOWING <%= categories.length %> OF <%= total %> CATEGORIES</div>
        <div class="pagination">
          <% if (currentPage > 1) { %>
            <a class="page-btn" href="/admin/categories?page=<%= currentPage - 1 %>&search=<%= search %>">
              <i class="fa-solid fa-chevron-left" style="font-size:10px;"></i>
            </a>
          <% } else { %>
            <span class="page-btn disabled"><i class="fa-solid fa-chevron-left" style="font-size:10px;"></i></span>
          <% } %>

          <% for (let p = 1; p <= totalPages; p++) { %>
            <a class="page-btn <%= p === currentPage ? 'active' : '' %>"
               href="/admin/categories?page=<%= p %>&search=<%= search %>"><%= p %></a>
          <% } %>

          <% if (currentPage < totalPages) { %>
            <a class="page-btn" href="/admin/categories?page=<%= currentPage + 1 %>&search=<%= search %>">
              <i class="fa-solid fa-chevron-right" style="font-size:10px;"></i>
            </a>
          <% } else { %>
            <span class="page-btn disabled"><i class="fa-solid fa-chevron-right" style="font-size:10px;"></i></span>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Stats Strip -->
    <div class="stats-strip">
      <div class="stat-box">
        <div class="stat-label">TOTAL CATEGORIES</div>
        <div class="stat-value"><%= total %></div>
      </div>
      <div class="stat-box">
        <div class="stat-label">ACTIVE LISTINGS</div>
        <div class="stat-value"><%= activeListings %> <span style="font-size:14px;letter-spacing:2px;">Items</span></div>
      </div>
    </div>
  </div>

  <div class="admin-footer">ROYALMIST PREMIUM ADMIN INTERFACE</div>
</div>

<div class="confirm-overlay" id="confirmOverlay">
  <div class="confirm-box">
    <div class="confirm-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
    <div class="confirm-title">DELETE CATEGORY</div>
    <p class="confirm-msg" id="confirmMsg"></p>
    <div class="confirm-actions">
      <button class="btn-cancel-confirm" onclick="closeConfirm()">CANCEL</button>
      <button class="btn-confirm-delete" id="confirmDeleteBtn">DELETE</button>
    </div>
  </div>
</div>

<div id="toast"></div>

<script>
/* ── Search with debounce ── */
const searchInput = document.getElementById('searchInput');
const clearBtn    = document.getElementById('clearBtn');
const searchForm  = document.getElementById('searchForm');
let searchTimer;

searchInput.addEventListener('input', function () {
  clearBtn.classList.toggle('visible', this.value.length > 0);
  clearTimeout(searchTimer);
  searchTimer = setTimeout(() => searchForm.submit(), 500);
});

clearBtn.addEventListener('click', function () {
  searchInput.value = '';
  clearBtn.classList.remove('visible');
  window.location.href = '/admin/categories?page=1&search=';
});

/* ── Toast ── */
function showToast(msg, type) {
  const t = document.getElementById('toast');
  t.innerHTML         = msg;
  t.style.color       = type === 'fail' ? '#e74c3c' : 'var(--gold)';
  t.style.borderColor = type === 'fail' ? '#e74c3c' : 'var(--gold)';
  t.style.display     = 'block';
  setTimeout(() => t.style.display = 'none', 3000);
}

/* ── Hamburger ── */
document.getElementById('hamburger').addEventListener('click', () => {
  document.getElementById('sidebar').classList.add('open');
  document.getElementById('sidebarOverlay').classList.add('active');
});
document.getElementById('sidebarOverlay').addEventListener('click', () => {
  document.getElementById('sidebar').classList.remove('open');
  document.getElementById('sidebarOverlay').classList.remove('active');
});

/* ── Delete Confirm ── */
let pendingDeleteId = null;

function confirmDelete(id, name) {
  pendingDeleteId = id;
  document.getElementById('confirmMsg').innerHTML =
    `Are you sure you want to delete <strong style="color:var(--gold)">${name}</strong>?<br>This action soft-deletes the category.`;
  document.getElementById('confirmOverlay').classList.add('active');
}

function closeConfirm() {
  pendingDeleteId = null;
  document.getElementById('confirmOverlay').classList.remove('active');
}

document.getElementById('confirmDeleteBtn').addEventListener('click', async function () {
  if (!pendingDeleteId) return;
  this.textContent = 'DELETING...';
  this.disabled    = true;

  try {
    const res  = await fetch(`/admin/categories/delete/${pendingDeleteId}`, { method: 'POST' });
    const data = await res.json();

    closeConfirm();
    this.textContent = 'DELETE';
    this.disabled    = false;

    if (data.success) {
      showToast('✓ ' + data.message);
      setTimeout(() => location.reload(), 1200);
    } else {
      showToast('✗ ' + (data.message || 'Delete failed.'), 'fail');
    }
  } catch (e) {
    closeConfirm();
    this.textContent = 'DELETE';
    this.disabled    = false;
    showToast('✗ Server error.', 'fail');
  }
});

document.getElementById('confirmOverlay').addEventListener('click', function (e) {
  if (e.target === this) closeConfirm();
});






/* ── Edit Modal ── */
let currentEditId = null;

function openEditModal(id, name, desc) {
  currentEditId = id;
  document.getElementById('editingName').textContent = name;
  document.getElementById('editName').value = name;
  document.getElementById('editDesc').value = desc || '';
  document.getElementById('editNameErr').classList.remove('visible');
  document.getElementById('editOverlay').classList.add('active');
  setTimeout(() => document.getElementById('editName').focus(), 100);
}

function closeEditModal() {
  document.getElementById('editOverlay').classList.remove('active');
  currentEditId = null;
}

async function saveCategory() {
  const name        = document.getElementById('editName').value.trim();
  const description = document.getElementById('editDesc').value.trim();
  const errEl       = document.getElementById('editNameErr');
  errEl.classList.remove('visible');
  if (!name) { errEl.classList.add('visible'); return; }

  const btn = document.getElementById('editSaveBtn');
  btn.disabled = true;
  btn.textContent = 'SAVING...';

  try {
    const res  = await fetch(`/admin/categories/edit/${currentEditId}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, description })
    });
    const data = await res.json();
    btn.disabled  = false;
    btn.innerHTML = '<i class="fa-solid fa-floppy-disk" style="font-size:9px;"></i> SAVE CHANGES';
    if (data.success) {
      closeEditModal();
      showToast('✓ ' + data.message);
      setTimeout(() => location.reload(), 1200);
    } else {
      showToast('✗ ' + (data.message || 'Update failed.'), 'fail');
    }
  } catch (e) {
    btn.disabled  = false;
    btn.innerHTML = '<i class="fa-solid fa-floppy-disk" style="font-size:9px;"></i> SAVE CHANGES';
    showToast('✗ Server error.', 'fail');
  }
}

document.getElementById('editOverlay').addEventListener('click', function(e) {
  if (e.target === this) closeEditModal();
});
  
document.getElementById('editName').addEventListener('keydown', e => {
  if (e.key === 'Enter') saveCategory();
});
</script>
</body>
<!-- ── EDIT MODAL ── -->
<div id="editOverlay">
  <div class="edit-modal">
    <div class="edit-modal-header">
      <div class="table-title">EDIT CATEGORY</div>
      <div class="table-subtitle" id="editingName" style="margin-top:6px;color:#aaa;"></div>
      <button class="modal-close" onclick="closeEditModal()">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
    <div class="edit-modal-body">
      <div class="field">
        <label>CATEGORY NAME</label>
        <input type="text" id="editName" placeholder="Enter category name..." maxlength="60">
        <div class="field-error" id="editNameErr">Category name is required.</div>
      </div>
      <div class="field">
        <label>DESCRIPTION</label>
        <textarea id="editDesc" placeholder="Enter description..." rows="4" maxlength="300"></textarea>
      </div>
      <div class="form-actions">
        <button class="btn-action btn-edit" onclick="closeEditModal()">CANCEL</button>
        <button class="btn-action btn-list" id="editSaveBtn" onclick="saveCategory()">
          <i class="fa-solid fa-floppy-disk" style="font-size:9px;"></i> SAVE CHANGES
        </button>
      </div>
    </div>
  </div>
</div>
</html>
