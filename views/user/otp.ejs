<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify OTP | Royal Mist</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        :root { --gold: #c4a14d; --dark-bg: #000000; }
        body { background-color: var(--dark-bg); color: #fff; font-family: 'Montserrat', sans-serif; }
        h2 { font-family: 'Playfair Display', serif; }
        
        .otp-container { max-width: 400px; margin: 80px auto; padding: 20px; }
        label { color: var(--gold); font-size: 0.75rem; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 8px; display: block; }
        
        input { background: transparent !important; border: 1px solid #333 !important; color: #fff !important; border-radius: 0 !important; padding: 15px !important; margin-bottom: 10px; text-align: center; letter-spacing: 10px; font-size: 1.5rem; }
        input:focus { border-color: var(--gold) !important; box-shadow: none !important; }
        
        .timer-text { color: #888; font-size: 0.8rem; margin-bottom: 20px; }
        .btn-verify { background: var(--gold); color: #000; border: none; width: 100%; padding: 15px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; }
        .btn-verify:hover { background: #e2bd65; }
        
        #resendBtn { color: var(--gold); cursor: pointer; text-decoration: underline; display: none; }
    </style>
</head>
<body>
    <div id="successToast" style="
    display:none;
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: black;
    color: #c4a14d;
    border: 2px solid #c4a14d;
    padding: 15px 25px;
    font-weight: 700;
    border-radius: 8px;
    font-family: 'Montserrat', sans-serif;
    z-index: 9999;
    align-items:center;
    gap:10px;
    box-shadow: 0 0 10px rgba(0,0,0,0.5);
">
    <span style="font-size:18px;"></span>
    <span id="successText">OTP Verified!</span>
</div>

<div class="container otp-container">
    <h2 class="text-center mb-2">Verify OTP</h2>
    <p class="text-center text-secondary small mb-4">Please enter the 6-digit code sent to your email.</p>

    <form>
        <label>Verification Code</label>
        <input type="text" class="form-control" placeholder="000000" maxlength="6" required>
        <p id="otp-error" style="color:red; font-size:12px; margin-top:5px; display:none;"></p>
        
        <div class="timer-text text-center" id="timerBox">Resend code in <span id="timer">60</span>s</div>
        <div class="text-center"><span id="resendBtn">Resend New Code</span></div>

        <button type="submit" class="btn-verify mt-3">Verify Code →</button>
    </form>
</div>

<script>
   let timeLeft = 60;
const timerSpan = document.getElementById('timer');
const timerBox = document.getElementById('timerBox');
const resendBtn = document.getElementById("resendBtn");

let countdown;

// Start timer function
function startTimer() {
    clearInterval(countdown); // clear previous timer if any
    timeLeft = 60;
    timerSpan.textContent = timeLeft;
    timerBox.style.display = 'block';
    resendBtn.style.display = 'none';

    countdown = setInterval(() => {
        timeLeft--;
        timerSpan.textContent = timeLeft;
        if(timeLeft<=10){
            timerBox.style.color = "red"
        }else{
            timerBox.style.color="#888"
        }
        if (timeLeft <= 0) {
            clearInterval(countdown);
            timerBox.style.display = 'none';
            resendBtn.style.display = 'inline-block';
        }
    }, 1000);
}

// start first timer on page load
startTimer();

// Form submit logic
const form = document.querySelector("form")
const otpInput = document.querySelector("input")
const otpError = document.getElementById("otp-error")
const submitBtn = document.querySelector(".btn-verify");

otpInput.addEventListener("input", () => {
    otpInput.value = otpInput.value.replace(/\D/g,''); 
});


form.addEventListener("submit", async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.innerText = "VERIFYING...";
    
    const otp = otpInput.value.trim();
    otpError.style.display = "none";
    otpError.innerText = "";

    if (!otp) {
        otpError.innerText = "Please fill OTP";
        otpError.style.display = "block";
        submitBtn.disabled = false;
        submitBtn.innerText = "Verify Code →";
        return;
    }

    if (otp.length !== 6 || !/^\d+$/.test(otp)) {
        otpError.innerText = "Enter a valid 6-digit OTP";
        otpError.style.display = "block";
        submitBtn.disabled = false;
        submitBtn.innerText = "Verify Code →";
        return;
    }

    try {
        const params = new URLSearchParams(window.location.search);
        const flow = params.get('flow');
        const endpoint = flow === 'forgot' ? '/verify-forgot-otp' : '/verify-otp';

        const res = await fetch(endpoint, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ otp }),
            credentials: "include"
        });
        const data = await res.json();

        if (data.success) {
            const toast = document.getElementById("successToast");
            const text = document.getElementById("successText");
            toast.style.display = "flex";
            if (flow === 'forgot') {
                text.innerText = "OTP Verified! Redirecting...";
                setTimeout(() => {
                    toast.style.display = "none";
                    window.location.href = "/reset-password";
                }, 2000);
            } else {
                text.innerText = "OTP Verified! Redirecting to Home...";
                setTimeout(() => {
                    toast.style.display = "none";
                    window.location.href = "/home";
                }, 2000);
            }
        } else {
            otpError.innerText = data.errors?.otp || "Invalid OTP. Try again.";
            otpError.style.display = "block";
            submitBtn.disabled = false;
            submitBtn.innerText = "Verify Code →";
        }

    } catch (err) {
        console.log(err);
        submitBtn.disabled = false;
        submitBtn.innerText = "Verify Code →";
    }
});

// Resend OTP logic
resendBtn.onclick = async () => {

        otpInput.value = '';               
   otpError.style.display = 'none';
otpError.innerText = "";
    try {
        const res = await fetch("/resend-otp", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            credentials:"include"
        });
        const data = await res.json();
        if (data.success) {
    const toast = document.getElementById("successToast");
    const text = document.getElementById("successText");
    text.innerText = "OTP resent successfully!";
    toast.style.display = "flex";

    startTimer(); // reset and restart timer on resend

    setTimeout(() => {
        toast.style.display = "none";
    }, 2000); // hide toast after 2 seconds
} else {
  const toast = document.getElementById("successToast");
  const text = document.getElementById("successText");
  toast.style.borderColor = "red";
  toast.style.color = "red";
  text.innerText = data.errors?.otp || "Failed to resend OTP";
  toast.style.display = "flex";

  setTimeout(() => {
    toast.style.display = "none";
    toast.style.borderColor = "#c4a14d";
    toast.style.color = "#c4a14d";
  }, 3000);
}
    } catch (err) {
        console.log(err);
    }
};


</script>
</body>
</html>