<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Profile</title>

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

:root {
    --gold: #c4a14d;
    --bg: #000;
    --card: #0a0a0a;
}

body {
    background: var(--bg);
    color: #fff;
    font-family: 'Playfair Display', serif;
}

/* HEADER */
.top-bar {
    border-bottom: 1px solid #222;
    padding: 20px 0;
}

.profile-title {
    color: var(--gold);
    letter-spacing: 3px;
    font-size: 20px;
    text-transform: none; /* only P caps manually */
}

/* MENU */
.menu {
    display: flex;
    gap: 20px;
}

.menu a {
    color: #fff;
    text-decoration: none;
    font-size: 13px;
    letter-spacing: 2px;
    transition: 0.3s;
}

.menu a:hover {
    color: var(--gold);
}

/* BUTTON */
.btn-gold {
    border: 1px solid var(--gold);
    color: var(--gold);
    background: #000;
    padding: 6px 18px;
    font-size: 12px;
    transition: 0.3s;
}

.btn-gold:hover {
    background: var(--gold);
    color: #000;
}

/* SECTION */
.section-title {
    margin: 40px 0 20px;
    padding-left: 15px;
    position: relative;
}

.section-title::before {
    content: "";
    position: absolute;
    left: 0;
    top: 6px;
    width: 3px;
    height: 20px;
    background: var(--gold);
}

/* CARD */
.card-box {
    border: 1px solid #1a1a1a;
    padding: 30px;
    background: var(--card);
    overflow: visible; /* FIX */
}

/* PROFILE IMAGE */
.profile-img {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: #111;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
}

.profile-img .plus {
    position: absolute;
    bottom: 0;
    right: 0;
    background: var(--gold);
    color: #000;
    border-radius: 50%;
    font-size: 12px;
    padding: 5px;
}

/* FIELD */
.field {
    margin-top: 20px;
}

.field label {
    font-size: 11px;
    color: var(--gold);
    letter-spacing: 2px;
}

.field p {
    border-bottom: 1px solid #222;
    padding-bottom: 6px;
}

/* 🔥 ADDRESS PERFECT FIX */
.address-wrapper {
    display: flex;
    gap: 25px;
    align-items: stretch;
    margin-bottom: 50px;
}

.address-col {
    flex: 1;
    display: flex;
}

.address-box {
    border: 1px solid #1a1a1a;
    padding: 25px;
    background: var(--card);
    width: 100%;
}

.add-box {
    border: 1px dashed #333;
    width: 100%;
    min-height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    cursor: pointer;
}

.add-box span {
    color: var(--gold);
    font-size: 22px;
}

/* MOBILE */
@media(max-width:768px){

    .top-bar {
        flex-direction: column;
        gap: 15px;
        text-align: center;
    }

    .menu {
        flex-wrap: wrap;
        justify-content: center;
    }

    .top-bar > div:last-child {
        display: flex;
        gap: 10px;
        justify-content: center;
    }

    .address-wrapper {
        flex-direction: column;
    }
}

</style>
</head>

<body>

<!-- HEADER -->
<div class="container top-bar d-flex justify-content-between align-items-center">

    <div class="profile-title">Profile</div>

    <div class="menu">
        <a href="#">Order history</a>
        <a href="#">Wallet</a>
        <a href="#">Add address</a>
    </div>

    <div>
        <button class="btn-gold">HOME</button>
        <button class="btn-gold">LOGOUT</button>
    </div>

</div>

<div class="container">

    <!-- PROFILE -->
    <h3 class="section-title">User Profile</h3>

    <div class="card-box">

        <div class="profile-img mb-4">
            <div class="plus">+</div>
        </div>

        <div class="row">
            <div class="col-md-6 field">
                <label>FIRST NAME</label>
                <p><%= user.firstName %></p>
            </div>

            <div class="col-md-6 field">
                <label>LAST NAME</label>
                <p><%= user.lastName %></p>
            </div>

            <div class="col-md-6 field">
                <label>EMAIL</label>
                <p><%= user.email %></p>
            </div>

            <div class="col-md-6 field">
                <label>PHONE NUMBER</label>
                <p><%= user.phone %></p>
            </div>

            <div class="col-12 field">
                <label>REFERRAL CODE</label>
                <p><%= user.referralCode %></p>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2 flex-wrap">
            <button class="btn-gold">EDIT PROFILE</button>
            <button class="btn-gold">CHANGE PASSWORD</button>
        </div>

    </div>

    <!-- ADDRESS -->
    <h3 class="section-title">Saved Addresses</h3>

    <div class="address-wrapper">

        <!-- ADDRESS -->
        <div class="address-col">
            <div class="address-box">
                <h5><%= user.firstName %></h5>

                <p>
                    <%= address.street %><br>
                    <%= address.city %> - <%= address.pincode %><br>
                    <%= address.state %>, India
                </p>

                <div class="d-flex gap-2">
                    <button class="btn-gold">EDIT</button>
                    <button class="btn-gold">DELETE</button>
                </div>
            </div>
        </div>

        <!-- ADD ADDRESS -->
        <div class="address-col">
            <div class="add-box">
                <span>+</span>
                <p class="mt-2">ADD NEW ADDRESS</p>
            </div>
        </div>

    </div>

</div>

</body>
</html>