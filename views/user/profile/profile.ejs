<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Profile</title>

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet"/>

<style>

:root {
    --gold: #c4a14d;
    --bg: #000;
    --card: #0a0a0a;
}

body {
    background: var(--bg);
    color: #fff;
    font-family: 'Playfair Display', serif;
}

/* HEADER */
.top-bar {
    border-bottom: 1px solid #222;
    padding: 20px 0;
}

.profile-title {
    color: var(--gold);
    letter-spacing: 3px;
    font-size: 20px;
    text-transform: none; /* only P caps manually */
}

/* MENU */
.menu {
    display: flex;
    gap: 20px;
}

.menu a {
    color: #fff;
    text-decoration: none;
    font-size: 13px;
    letter-spacing: 2px;
    transition: 0.3s;
}

.menu a:hover {
    color: var(--gold);
}

/* BUTTON */
.btn-gold {
    border: 1px solid var(--gold);
    color: var(--gold);
    background: #000;
    padding: 6px 18px;
    font-size: 12px;
    transition: 0.3s;
}

.btn-gold:hover {
    background: var(--gold);
    color: #000;
}

/* SECTION */
.section-title {
    margin: 40px 0 20px;
    padding-left: 15px;
    position: relative;
}

.section-title::before {
    content: "";
    position: absolute;
    left: 0;
    top: 6px;
    width: 3px;
    height: 20px;
    background: var(--gold);
}

/* CARD */
.card-box {
    border: 1px solid #1a1a1a;
    padding: 30px;
    background: var(--card);
    overflow: visible; /* FIX */
}

/* PROFILE IMAGE */
.profile-img {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: #111;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
}

.profile-img .plus {
    position: absolute;
    bottom: 0;
    right: 0;
    background: var(--gold);
    color: #000;
    border-radius: 50%;
    font-size: 12px;
    padding: 5px;
}

/* FIELD */
.field {
    margin-top: 20px;
}

.field label {
    font-size: 11px;
    color: var(--gold);
    letter-spacing: 2px;
}

.field p {
    border-bottom: 1px solid #222;
    padding-bottom: 6px;
}

.address-wrapper {
    display: flex;
    gap: 25px;
    align-items: stretch;
    margin-bottom: 50px;
}

.address-col {
    flex: 1;
    display: flex;
}

.address-box {
    border: 1px solid #1a1a1a;
    padding: 25px;
    background: var(--card);
    width: 100%;
}

.add-box {
    border: 1px dashed #333;
    width: 100%;
    min-height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    cursor: pointer;
}

.add-box span {
    color: var(--gold);
    font-size: 22px;
}

/* MOBILE */
@media(max-width:768px){

    .top-bar {
        flex-direction: column;
        gap: 15px;
        text-align: center;
    }

    .menu {
        flex-wrap: wrap;
        justify-content: center;
    }

    .top-bar > div:last-child {
        display: flex;
        gap: 10px;
        justify-content: center;
    }

    .address-wrapper {
        flex-direction: column;
    }
}

/* PROFILE IMAGE HOVER */
.profile-img {
    cursor: pointer;
}
.profile-img:hover .plus {
    transform: scale(1.2);
    transition: 0.2s;
}

/* SOURCE PICKER MODAL */
.source-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.85);
    z-index: 1000;
    align-items: flex-end;
    justify-content: center;
}
.source-modal-overlay.active {
    display: flex;
}
.source-sheet {
    background: #111;
    border: 1px solid #2a2a2a;
    border-bottom: none;
    width: 100%;
    max-width: 480px;
    padding: 30px 24px 40px;
    border-radius: 16px 16px 0 0;
    animation: slideUp 0.3s ease;
}
@keyframes slideUp {
    from { transform: translateY(100%); }
    to   { transform: translateY(0); }
}
.source-sheet h6 {
    color: #555;
    font-size: 11px;
    letter-spacing: 3px;
    text-align: center;
    margin-bottom: 24px;
}
.source-btn {
    width: 100%;
    padding: 14px;
    margin-bottom: 12px;
    background: #1a1a1a;
    border: 1px solid #2a2a2a;
    color: #fff;
    font-family: 'Playfair Display', serif;
    font-size: 13px;
    letter-spacing: 2px;
    cursor: pointer;
    transition: 0.2s;
}
.source-btn:hover {
    background: var(--gold);
    color: #000;
    border-color: var(--gold);
}
.source-cancel {
    width: 100%;
    padding: 12px;
    background: transparent;
    border: 1px solid #333;
    color: #555;
    font-family: 'Playfair Display', serif;
    font-size: 12px;
    letter-spacing: 2px;
    cursor: pointer;
    margin-top: 4px;
    transition: 0.2s;
}
.source-cancel:hover { color: #fff; border-color: #555; }

/* CROP MODAL */
.crop-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.95);
    z-index: 1100;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px;
}
.crop-modal-overlay.active {
    display: flex;
}
.crop-container {
    width: 100%;
    max-width: 400px;
    background: #0d0d0d;
    border: 1px solid #2a2a2a;
    padding: 24px;
}
.crop-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}
.crop-header span {
    color: var(--gold);
    font-size: 11px;
    letter-spacing: 3px;
}
.crop-header button {
    background: none;
    border: none;
    color: #555;
    font-size: 20px;
    cursor: pointer;
    line-height: 1;
}
.crop-header button:hover { color: #fff; }
.crop-img-wrap {
    width: 100%;
    height: 300px;
    overflow: hidden;
    background: #000;
}
.crop-img-wrap img {
    max-width: 100%;
    display: block;
}
.crop-actions {
    display: flex;
    gap: 12px;
    margin-top: 20px;
}
.crop-save {
    flex: 1;
    padding: 12px;
    background: var(--gold);
    color: #000;
    border: none;
    font-family: 'Playfair Display', serif;
    font-size: 12px;
    letter-spacing: 2px;
    cursor: pointer;
    transition: 0.2s;
}
.crop-save:hover { background: #d4b05d; }
.crop-cancel {
    padding: 12px 20px;
    background: transparent;
    border: 1px solid #333;
    color: #555;
    font-family: 'Playfair Display', serif;
    font-size: 12px;
    letter-spacing: 2px;
    cursor: pointer;
    transition: 0.2s;
}
.crop-cancel:hover { color: #fff; border-color: #555; }
.crop-saving {
    display: none;
    text-align: center;
    color: var(--gold);
    font-size: 11px;
    letter-spacing: 2px;
    margin-top: 12px;
}

</style>
</head>

<body>

<!-- HEADER -->
<div class="container top-bar d-flex justify-content-between align-items-center">

    <div class="profile-title">Profile</div>

    <div class="menu">
        <a href="#">Order history</a>
        <a href="#">Wallet</a>
        <a href="#">Add address</a>
    </div>

    <div>
        <button class="btn-gold" onclick="window.location.href='/home'">HOME</button>
        <button class="btn-gold" id="logoutBtn">LOGOUT</button>
    </div>

</div>

<div class="container">

    <!-- PROFILE -->
    <h3 class="section-title">User Profile</h3>

    <div class="card-box">

        <div class="profile-img mb-4" id="profileWrapper">
             <% if (user.profileImage) { %>
        <img src="<%= user.profileImage %>?t=<%= Date.now() %>" 
             style="width:80px;height:80px;border-radius:50%;object-fit:cover;">
    <% } else { %>
        👤
    <% } %>
               <div class="plus" id="uploadBtn">+</div>
               </div>
    <input type="file" id="profileInputGallery" style="display:none;" accept="image/*">
    <input type="file" id="profileInputCamera" style="display:none;" accept="image/*" capture="user">

    <!-- SOURCE PICKER (bottom sheet) -->
    <div class="source-modal-overlay" id="sourceModal">
        <div class="source-sheet">
            <h6>CHANGE PHOTO</h6>
            <button class="source-btn" id="chooseGallery"> &nbsp; CHOOSE FROM GALLERY</button>
            <button class="source-btn" id="removePhoto" style="color:#ff4444;border-color:#ff4444;">🗑 &nbsp; REMOVE PHOTO</button>
            <button class="source-cancel" id="sourceCancel">CANCEL</button>
        </div>
    </div>

    <!-- CROP MODAL -->
    <div class="crop-modal-overlay" id="cropModal">
        <div class="crop-container">
            <div class="crop-header">
                <span>CROP PHOTO</span>
                <button id="cropClose">✕</button>
            </div>
            <div class="crop-img-wrap">
                <img id="cropImage" src="">
            </div>
            <div class="crop-actions">
                <button class="crop-cancel" id="cropCancelBtn">CANCEL</button>
                <button class="crop-save" id="cropSaveBtn">SAVE PHOTO</button>
            </div>
            <div class="crop-saving" id="cropSaving">UPLOADING...</div>
        </div>
    </div>

        <div class="row">
            <div class="col-md-6 field">
                <label>FIRST NAME</label>
                <p><%= user.firstName %></p>
            </div>

            <div class="col-md-6 field">
                <label>LAST NAME</label>
                <p><%= user.lastName %></p>
            </div>

            <div class="col-md-6 field">
                <label>EMAIL</label>
                <p><%= user.email %></p>
            </div>

            <div class="col-md-6 field">
                <label>PHONE NUMBER</label>
                <p><%= user.phone %></p>
            </div>

            <div class="col-12 field">
                <label>REFERRAL CODE</label>
                <p><%= user.referralCode %></p>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2 flex-wrap">
            <button class="btn-gold" onclick="window.location.href='/editProfile'">EDIT PROFILE</button>
            <button class="btn-gold">CHANGE PASSWORD</button>
        </div>

    </div>

    <!-- ADDRESS -->
    <h3 class="section-title">Saved Addresses</h3>

    <div class="address-wrapper">

        <% if (user.addresses && user.addresses.length > 0) { %>
  <% user.addresses.forEach(address => { %>
    <div class="address-col">
        <div class="address-box">
            <h5><%= user.firstName %></h5>
            <p>
                <%= address.street %><br>
                <%= address.city %> - <%= address.pincode %><br>
                <%= address.state %>, India
            </p>
            <div class="d-flex gap-2">
                <button class="btn-gold">EDIT</button>
                <button class="btn-gold">DELETE</button>
            </div>
        </div>
    </div>
  <% }) %>
<% } %>

        <!-- ADD ADDRESS -->
        <div class="address-col">
            <div class="add-box">
                <span>+</span>
                <p class="mt-2">ADD NEW ADDRESS</p>
            </div>
        </div>

    </div>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

<script>
    const profileWrapper = document.getElementById("profileWrapper");
const sourceModal    = document.getElementById("sourceModal");
const cropModal      = document.getElementById("cropModal");
const cropImage      = document.getElementById("cropImage");
const cropSaving     = document.getElementById("cropSaving");
const galleryInput   = document.getElementById("profileInputGallery");
const cameraInput    = document.getElementById("profileInputCamera");

let cropper;

// open source picker
document.getElementById("uploadBtn").addEventListener("click", (e) => {
    e.stopPropagation();
    sourceModal.classList.add("active");
});

document.getElementById("chooseGallery").addEventListener("click", () => {
    sourceModal.classList.remove("active");
    galleryInput.click();
});

document.getElementById("removePhoto").addEventListener("click", async () => {
    sourceModal.classList.remove("active");
    try {
        const res  = await fetch("/removeProfileImage", { method: "POST" });
        const data = await res.json();
        if (data.success) {
            profileWrapper.innerHTML = `👤<div class="plus" id="uploadBtn" style="cursor:pointer">+</div>`;
            document.getElementById("uploadBtn").addEventListener("click", (e) => {
                e.stopPropagation();
                sourceModal.classList.add("active");
            });
        } else {
            alert("Failed to remove photo.");
        }
    } catch (err) {
        console.error(err);
        alert("Error removing photo.");
    }
});

document.getElementById("sourceCancel").addEventListener("click", () => {
    sourceModal.classList.remove("active");
});

sourceModal.addEventListener("click", (e) => {
    if (e.target === sourceModal) sourceModal.classList.remove("active");
});

function handleFile(e) {
    const file = e.target.files[0];
    if (!file) return;
    e.target.value = "";
    const reader = new FileReader();
    reader.onload = function(ev) {
        cropImage.src = ev.target.result;
        cropModal.classList.add("active");
        if (cropper) cropper.destroy();
        cropper = new Cropper(cropImage, {
            aspectRatio: 1,
            viewMode: 1,
            dragMode: "move",
            autoCropArea: 0.9,
            responsive: true,
        });
    };
    reader.readAsDataURL(file);
}

galleryInput.addEventListener("change", handleFile);
cameraInput.addEventListener("change", handleFile);

function closeCrop() {
    cropModal.classList.remove("active");
    if (cropper) { cropper.destroy(); cropper = null; }
}

document.getElementById("cropCancelBtn").addEventListener("click", closeCrop);
document.getElementById("cropClose").addEventListener("click", closeCrop);

document.getElementById("cropSaveBtn").addEventListener("click", async () => {
    const canvas = cropper.getCroppedCanvas({ width: 200, height: 200 });
    cropSaving.style.display = "block";
    document.getElementById("cropSaveBtn").disabled = true;

    canvas.toBlob(async (blob) => {
        const formData = new FormData();
        formData.append("profileImage", blob, "profile.jpg");
        try {
            const res  = await fetch("/updateProfileImage", { method: "POST", body: formData });
            const data = await res.json();
            if (data.success) {
                let img = profileWrapper.querySelector("img");
                if (!img) {
                    profileWrapper.innerHTML = "";
                    img = document.createElement("img");
                    img.style.cssText = "width:80px;height:80px;border-radius:50%;object-fit:cover;";
                    profileWrapper.appendChild(img);
                    const plusBtn = document.createElement("div");
                    plusBtn.id = "uploadBtn";
                    plusBtn.className = "plus";
                    plusBtn.textContent = "+";
                    plusBtn.style.cursor = "pointer";
                    profileWrapper.appendChild(plusBtn);
                    plusBtn.addEventListener("click", (e) => {
                        e.stopPropagation();
                        sourceModal.classList.add("active");
                    });
                }
                img.src = data.imageUrl + "?t=" + Date.now();
                closeCrop();
            } else {
                alert("Failed to save image. Try again.");
            }
        } catch (err) {
            console.error(err);
            alert("Upload failed. Check your connection.");
        } finally {
            cropSaving.style.display = "none";
            document.getElementById("cropSaveBtn").disabled = false;
        }
    }, "image/jpeg", 0.9);
});
</script>

</body>
</html>