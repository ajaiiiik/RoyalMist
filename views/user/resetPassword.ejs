<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password | Royal Mist</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --gold: #c4a14d;
            --gold-light: #e2bd65;
            --gold-dark: #b59242;
            --dark-bg: #000000;
            --border-dim: #222;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background-color: var(--dark-bg);
            color: #fff;
            font-family: 'Montserrat', sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .page-wrapper {
            width: 100%;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 60px 20px;
        }

        .rp-container {
            width: 100%;
            max-width: 420px;
            animation: fadeUp 0.55s ease both;
        }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(22px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .rp-title {
            font-family: 'Playfair Display', serif;
            font-size: 2.5rem;
            font-weight: 700;
            text-align: center;
            line-height: 1.2;
            margin-bottom: 8px;
            letter-spacing: 0;
        }

        .rp-description {
            text-align: center;
            color: #6c757d;
            font-size: 0.875rem;
            font-weight: 400;
            line-height: 1.5;
            margin-bottom: 48px;
        }

        label {
            display: block;
            color: var(--gold);
            font-size: 0.75rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 8px;
            font-weight: 400;
        }

        .input-wrapper {
            position: relative;
            margin-bottom: 20px;    
    align-items: center; 
        }

        .rp-input {

            width: 100%;
            background: transparent;
            border: 2px solid #222;
            color: #fff;
            border-radius: 0;
            padding: 12px 44px 12px 12px;
            font-family: 'Montserrat', sans-serif;
            font-size: 1rem;
            font-weight: 400;
            outline: none;
            transition: border-color 0.25s;
            -webkit-appearance: none;
            margin-bottom: 0;
            display: block;
        }

        .rp-input:focus { border-color: var(--gold); }
        .rp-input::placeholder { color: #3a3a3a; }

        .rp-input:-webkit-autofill,
        .rp-input:-webkit-autofill:focus {
            -webkit-box-shadow: 0 0 0px 1000px #000 inset !important;
            -webkit-text-fill-color: #fff !important;
            transition: background-color 5000s ease-in-out 0s;
        }

       .eye-toggle {
    position: absolute;
    right: 15px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: #fff;
    cursor: pointer;
    padding: 0;
    font-size: 1rem;
     line-height: 1;
    transition: color 0.2s;
    display: none;
     vertical-align: middle;
    margin-top: 0;
}

        .eye-toggle:hover { color: var(--gold); }

        .field-error {
            color: #e05555;
            font-size: 0.72rem;
            letter-spacing: 0.5px;
            min-height: 20px;
            display: block;
            margin-top: 6px;
            margin-bottom: 16px;
        }

        .btn-reset {
            width: 100%;
            background: linear-gradient(to right, var(--gold), var(--gold-dark));
            color: #000;
            border: none;
            padding: 15px;
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            cursor: pointer;
            transition: background 0.25s, transform 0.2s;
            margin-top: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .btn-reset:hover:not(:disabled) { background: var(--gold-light); transform: translateY(-2px); }
        .btn-reset:active:not(:disabled) { transform: translateY(0); }
        .btn-reset:disabled { opacity: 0.55; cursor: not-allowed; transform: none; }

        .btn-spinner {
            width: 16px;
            height: 16px;
            border: 2px solid rgba(0,0,0,0.25);
            border-top-color: #000;
            border-radius: 50%;
            animation: spin 0.7s linear infinite;
            display: none;
        }

        @keyframes spin { to { transform: rotate(360deg); } }

        .btn-cancel {
            width: 100%;
            background: transparent;
            color: var(--gold);
            border: 2px solid var(--border-dim);
            padding: 15px;
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            cursor: pointer;
            transition: border-color 0.25s, background 0.25s;
            margin-top: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            text-decoration: none;
        }

        .btn-cancel:hover {
            border-color: var(--gold);
            background: rgba(196,161,77,0.05);
            color: var(--gold);
        }

        .toast-bar {
            display: none;
            position: fixed;
            top: 22px;
            left: 50%;
            transform: translateX(-50%);
            background: #000;
            color: var(--gold);
            border: 2px solid var(--gold);
            padding: 13px 26px;
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
            font-size: 0.8rem;
            letter-spacing: 1.5px;
            border-radius: 6px;
            z-index: 9999;
            white-space: nowrap;
            animation: slideDown 0.3s ease;
        }

        @keyframes slideDown {
            from { opacity: 0; top: 8px; }
            to   { opacity: 1; top: 22px; }
        }

        @media (max-width: 480px) {
            .page-wrapper { padding: 50px 24px; }
            .rp-container { max-width: 100%; }
            .btn-reset, .btn-cancel { font-size: 0.8rem; letter-spacing: 1.5px; }
        }

        @media (max-width: 360px) {
            .btn-reset, .btn-cancel { padding: 14px 12px; font-size: 0.72rem; }
            .rp-title { font-size: 2rem; }
        }
    </style>
</head>
<body>

<div class="toast-bar" id="toast"></div>

<div class="page-wrapper">
    <div class="rp-container  mx-auto">

        <h2 class="rp-title text-center mb-2">Reset Password</h2>
        <p class="rp-description text-center mb-5 small">Please enter your new password below.</p>

        <form id="rpForm" novalidate>

            <label for="rp-password">New Password</label>
            <div class="input-wrapper">
                <input type="password" id="rp-password" name="password" class="rp-input" placeholder="••••••••" autocomplete="new-password">
                <button type="button" class="eye-toggle" id="togglePassword"><i class="fa fa-eye"></i></button>
            </div>
            <span class="field-error" id="password-error"></span>

            <label for="rp-confirm">Confirm New Password</label>
            <div class="input-wrapper">
                <input type="password" id="rp-confirm" name="confirmPassword" class="rp-input" placeholder="••••••••" autocomplete="new-password">
                <button type="button" class="eye-toggle" id="toggleConfirm"><i class="fa fa-eye"></i></button>
            </div>
            <span class="field-error" id="confirm-error"></span>

            <button type="submit" class="btn-reset" id="resetBtn">
                <div class="btn-spinner" id="btnSpinner"></div>
                <span id="btnText">RESET PASSWORD</span>
                <span id="btnArrow">→</span>
            </button>
        </form>

        <a href="/signin" class="btn-cancel">CANCEL</a>

    </div>
</div>

<script>
    const form           = document.getElementById('rpForm');
    const passwordInput  = document.getElementById('rp-password');
    const confirmInput   = document.getElementById('rp-confirm');
    const passwordError  = document.getElementById('password-error');
    const confirmError   = document.getElementById('confirm-error');
    const resetBtn       = document.getElementById('resetBtn');
    const btnSpinner     = document.getElementById('btnSpinner');
    const btnText        = document.getElementById('btnText');
    const btnArrow       = document.getElementById('btnArrow');
    const toast          = document.getElementById('toast');
    const togglePassword = document.getElementById('togglePassword');
    const toggleConfirm  = document.getElementById('toggleConfirm');

    function setupEyeToggle(input, btn) {
        input.addEventListener('input', () => {
            btn.style.display = input.value.length > 0 ? 'block' : 'none';
        });
        btn.addEventListener('click', () => {
            const isPassword = input.type === 'password';
            input.type = isPassword ? 'text' : 'password';
            btn.innerHTML = isPassword ? '<i class="fa fa-eye-slash"></i>' : '<i class="fa fa-eye"></i>';
        });
    }

    setupEyeToggle(passwordInput, togglePassword);
    setupEyeToggle(confirmInput, toggleConfirm);

    passwordInput.addEventListener('input', () => { passwordError.textContent = ''; passwordInput.style.borderColor = ''; });
    confirmInput.addEventListener('input',  () => { confirmError.textContent  = ''; confirmInput.style.borderColor  = ''; });

    function showToast(msg, isError = false) {
        toast.textContent = msg;
        toast.style.color = isError ? '#e05555' : 'var(--gold)';
        toast.style.borderColor = isError ? '#e05555' : 'var(--gold)';
        toast.style.display = 'block';
        setTimeout(() => { toast.style.display = 'none'; }, 2800);
    }

    function setLoading(loading) {
        resetBtn.disabled = loading;
        btnSpinner.style.display = loading ? 'block' : 'none';
        btnText.textContent = loading ? 'RESETTING...' : 'RESET PASSWORD';
        btnArrow.style.display = loading ? 'none' : 'inline';
    }

    function validatePassword(pw) {
        return pw.length >= 8 && /[^a-zA-Z0-9]/.test(pw);
    }

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        passwordError.textContent = ''; confirmError.textContent = '';
        passwordInput.style.borderColor = ''; confirmInput.style.borderColor = '';

        const password = passwordInput.value;
        const confirmPassword = confirmInput.value;

        if (!password) { passwordError.textContent = 'Please enter a new password.'; passwordInput.style.borderColor = '#e05555'; passwordInput.focus(); return; }
        if (!validatePassword(password)) { passwordError.textContent = 'Must be at least 8 characters including a symbol.'; passwordInput.style.borderColor = '#e05555'; passwordInput.focus(); return; }
        if (!confirmPassword) { confirmError.textContent = 'Please confirm your password.'; confirmInput.style.borderColor = '#e05555'; confirmInput.focus(); return; }
        if (password !== confirmPassword) { confirmError.textContent = 'Passwords do not match.'; confirmInput.style.borderColor = '#e05555'; confirmInput.focus(); return; }

        setLoading(true);

        try {
            const res = await fetch('/reset-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ password, confirmPassword }),
                credentials: 'include'
            });
            const data = await res.json();

            if (data.success) {
                showToast('Password reset successful!');
                setTimeout(() => { window.location.href = '/signin'; }, 2000);
            } else {
                if (data.errors?.password) { passwordError.textContent = data.errors.password; passwordInput.style.borderColor = '#e05555'; }
                else if (data.errors?.confirmPassword) { confirmError.textContent = data.errors.confirmPassword; confirmInput.style.borderColor = '#e05555'; }
                else { showToast(data.message || 'Something went wrong.', true); }
                setLoading(false);
            }
        } catch (err) {
            console.error(err);
            showToast('Network error. Please check your connection.', true);
            setLoading(false);
        }
    });
</script>
</body>
</html>