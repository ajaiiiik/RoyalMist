<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign In | Royal Mist</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root { 
            --gold: #c4a14d; 
            --dark-bg: #000000; 
        }

        body { 
            background-color: var(--dark-bg); 
            color: #fff; 
            font-family: 'Montserrat', sans-serif; 
        }

        h2 { font-family: 'Playfair Display', serif; font-size: 2.5rem; }
        
        .signin-container { 
            max-width: 400px; 
            margin: 80px auto; 
            padding: 20px; 
        }

        label { 
            color: var(--gold); 
            font-size: 0.75rem; 
            letter-spacing: 2px; 
            text-transform: uppercase; 
            margin-bottom: 8px; 
            display: block; 
        }
        
        input { 
            background: transparent !important; 
            border: 2px solid #222 !important; 
            color: #fff !important; 
            border-radius: 0 !important; 
            padding: 12px !important; 
            margin-bottom: 20px; 
        }

        input:focus { 
            border-color: var(--gold) !important; 
            box-shadow: none !important; 
        }
        
        .btn-signin { 
            background: linear-gradient(to right, #c4a14d, #b59242); 
            color: #000; 
            border: none; 
            width: 100%; 
            padding: 15px; 
            font-weight: 700; 
            text-transform: uppercase; 
            letter-spacing: 2px; 
            transition: 0.3s; 
        }

        .btn-signin:hover { 
            background: #e2bd65; 
            transform: translateY(-2px);
        }
        
        /* Divider Style */
        .divider {
            display: flex;
            align-items: center;
            text-align: center;
            margin: 25px 0;
            color: #444;
            font-size: 0.7rem;
            letter-spacing: 2px;
        }

        .divider::before, .divider::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid #222;
        }

        .divider:not(:empty)::before { margin-right: .5em; }
        .divider:not(:empty)::after { margin-left: .5em; }

        /* Google Button Style */
        .btn-google {
            background-color: transparent;
            color: #fff;
            border: 2px solid #222;
            width: 100%;
            padding: 15px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 0.8rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            transition: 0.3s;
        }

        .btn-google:hover {
            border-color: #fff;
            background: rgba(255, 255, 255, 0.05);
        }

        .forgot-link { 
            color: #888; 
            font-size: 0.75rem; 
            text-decoration: none; 
            display: block; 
            margin-bottom: 20px; 
        }

        a { color: var(--gold); text-decoration: none; }
        .footer-text { color: #555; font-size: 0.8rem; margin-top: 30px; }
    </style>
</head>
<body>
    <!-- Success Toast -->
<div id="signinToast" style="
    display:none;
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: black;
    color: #c4a14d;
    border: 2px solid #c4a14d;
    padding: 15px 25px;
    font-weight: 700;
    border-radius: 8px;
    font-family: 'Montserrat', sans-serif;
    z-index: 9999;
    align-items:center;
    gap:10px;
    box-shadow: 0 0 10px rgba(0,0,0,0.5);
">
    <span id="signinText">Signin successful</span>
</div>

<div class="container signin-container">
    <h2 class="text-center mb-2">Sign In</h2>
    <p class="text-center text-secondary mb-5 small">Welcome back to Royal Mist</p>

    <form id="signinForm">
        <label>Email Address</label>
        <input type="text" id="email"  name="email"  class="form-control" placeholder="vane@luxury.com">
        <p id="email-error" style="color:red; font-size:12px; display:none;"></p>

        <label>Password</label>
        <input type="password" id="password" name="password" class="form-control" placeholder="••••••••">
        <p id="password-error" style="color:red; font-size:12px; display:none;"></p>
        
        <a href="#" class="forgot-link text-end">Forgot password?</a>

        <button type="submit" class="btn-signin">Sign In →</button>
    </form>

    <div class="divider">OR SIGN IN WITH</div>

    <button type="button" class="btn-google">
        <i class="fab fa-google"></i>
        SIGN IN WITH GOOGLE
    </button>

    <p class="text-center footer-text">Don't have an account? <a href="#">Create an account</a></p>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  
const form = document.getElementById("signinForm");
const emailInput = document.getElementById("email");
const passwordInput = document.getElementById("password");
const emailError = document.getElementById("email-error");
const passwordError = document.getElementById("password-error");
const toast = document.getElementById("signinToast");
const toastText = document.getElementById("signinText");

form.addEventListener("submit", async (e) => {
  e.preventDefault();

  // Clear old errors
  emailError.style.display = "none";
  passwordError.style.display = "none";

  const formData = {
    email: emailInput.value.trim(),
    password: passwordInput.value
  };

  try {
    const res = await fetch("/auth/signin", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(formData)
    });

    const data = await res.json();

    if (data.success) {
      toastText.innerText = data.message || "Signin successful";
      toast.style.display = "flex";

      setTimeout(() => {
        toast.style.display = "none";
        window.location.href = "/home"; // redirect after signin
      }, 2000);
    } else {
      if (data.errors.email) {
        emailError.innerText = data.errors.email;
        emailError.style.display = "block";
      }
      if (data.errors.password) {
        passwordError.innerText = data.errors.password;
        passwordError.style.display = "block";
      }
    }
  } catch (err) {
    console.log(err);
  }
});
</script>
</body>
</html>