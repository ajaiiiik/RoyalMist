<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Royal Mist | Luxury Perfume Store</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --gold: #c4a14d;
            --dark-bg: #000000;
            --card-bg: #0a0a0a;
            --font-main: 'Playfair Display', serif;
        }

        * { box-sizing: border-box; }

        body {
            background-color: var(--dark-bg);
            color: #ffffff;
            font-family: var(--font-main);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
             overflow-y: visible !important;
        }

        /* --- NAVBAR --- */
        .navbar {
            background: rgba(0,0,0,0.95);
            border-bottom: 1px solid #222;
            padding: 15px 0;
             overflow: visible !important;
        }
        .navbar-brand {
            color: var(--gold) !important;
            letter-spacing: 4px;
            font-weight: 700;
            font-family: var(--font-main);
        }
        .nav-link {
            color: #fff !important;
            font-size: 12px;
            letter-spacing: 2px;
            font-family: var(--font-main);
        }
        .search-container {
            position: relative;
            margin-right: 20px;
        }
        .search-input {
            background: transparent;
            border: none;
            border-bottom: 1px solid #444;
            color: white;
            font-size: 13px;
            padding: 5px 25px 5px 5px;
            width: 150px;
            transition: 0.3s;
            font-family: var(--font-main);
        }
        .search-input:focus {
            outline: none;
            border-color: var(--gold);
            width: 200px;
        }
        .search-icon {
            position: absolute;
            right: 5px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 12px;
            color: #777;
        }

        
        .hero {
            height: 90vh;
            background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), 
                       url('/images/homeimage.png');
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
        }
        .hero-content h1 {
            font-size: clamp(2.5rem, 5vw, 4.5rem);
            margin-bottom: 20px;
        }
        .hero-content p {
           font-family: var(--font-main);
            color: #ccc;
            max-width: 600px;
            margin: 0 auto 30px;
        }
        .gold-text { color: var(--gold); }
        .btn-gold {
            background-color: var(--gold);
            color: #000;
            border-radius: 0;
            padding: 12px 35px;
            font-weight: 600;
            letter-spacing: 1px;
            border: none;
            transition: 0.3s;
            font-family: var(--font-main);
        }
        .btn-gold:hover {
    background-color: #b38f4d;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(196,161,77,0.3);
}

        /* --- FEATURE CARDS --- */
        .feature-box {
            position: relative;
            overflow: hidden;
            height: 400px;
        }
        .feature-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: brightness(0.6);
            transition: 0.5s;
        }
        .feature-box:hover img { transform: scale(1.05); }
        .feature-text {
            position: absolute;
            bottom: 30px;
            left: 30px;
            font-size: 24px;
        }

        /* --- PRODUCT CARDS --- */
        .product-card {
            background: var(--card-bg);
            border: 1px solid #1a1a1a;
            padding: 15px;
            transition: 0.3s;
            height: 100%;
            display: flex;
            flex-direction: column;
             justify-content: space-between;
        }
        .product-card:hover { border-color: var(--gold); }
        .img-wrapper {
            position: relative;
            margin-bottom: 15px;
            flex-shrink: 0;
        }
        .offer-tag {
            position: absolute;
            top: 10px;
            left: 10px;
            background: var(--gold);
            color: #000;
            font-size: 10px;
            padding: 2px 8px;
            font-weight: bold;
            font-family: var(--font-main);
            z-index: 1;
        }
        .product-body {
            display: flex;
            flex-direction: column;
            flex: 1;
        }
        .product-info-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 10px;
        }
        .product-name {
             font-size: 18px; 
             margin: 0;
            font-weight: 500; }
        .category-label { font-size: 11px; color: #777; letter-spacing: 1px; display: block; font-family: var(--font-main); }
        .rating-stars { color: var(--gold); font-size: 10px; margin-bottom: 5px; }
        .fragrance-type { font-size: 11px; color: var(--gold); text-transform: uppercase; font-family: var(--font-main); }
        
        .price-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: auto;
            padding-top: 15px;
        }
        .price { font-size: 18px; font-weight: 600; }
        .ml-text { font-size: 12px; color: #555; font-family: var(--font-main); }

        .view-btn {
            width: 100%;
            background: transparent;
            border: 1px solid #333;
            color: #fff;
            padding: 10px;
            font-size: 12px;
            margin-top: 15px;
            letter-spacing: 2px;
            transition: 0.3s;
            cursor: pointer;
           font-family: var(--font-main);
        }
        .view-btn:hover { 
            border-color: var(--gold);
             color: var(--gold);
             background: rgba(196,161,77,0.05);
             }
        footer {
            border-top: 1px solid #222;
            padding: 80px 0 30px;
           font-family: var(--font-main);
        }
        .footer-logo {
            font-family: var(--font-main);
            color: var(--gold);
            font-size: 24px;
            margin-bottom: 20px;
            letter-spacing: 4px;
            font-weight: 700;
            display: block;
        }
        .footer-head { color: #fff; font-size: 14px; letter-spacing: 1px; margin-bottom: 20px; font-weight: 600; }
        .footer-link { color: #777; text-decoration: none; font-size: 13px; display: block; margin-bottom: 10px; transition: 0.2s; }
        .footer-link:hover { color: var(--gold); }
        .social-icons i { color: #fff; margin-right: 20px; font-size: 18px; cursor: pointer; transition: 0.2s; }
        .social-icons i:hover { color: var(--gold); }
        .footer-bottom {
            border-top: 1px solid #1a1a1a;
            margin-top: 50px;
            padding-top: 25px;
            text-align: center;
        }
        /* USER DROPDOWN CLICK VERSION */
.user-dropdown {
    position: relative;
}

.user-icon {
   cursor: pointer;
    color: #fff;          
    background: none;     
    border: none;        
    padding: 0;           
    font-family: var(--font-main);
    display: flex;
    align-items: center;
    gap: 5px;
}

.user-icon:hover {
    background:none;
    color: #fff
    
}

.user-icon .caret {
    cursor: pointer;
    display: flex;
    align-items: center;
}

.username-text {
    cursor: default;
}

/* Arrow only: pointer hand */
.caret {
    /* cursor: pointer; */
    display: inline-flex;
    align-items: center;
}

/* ITEMS */
.dropdown-item-custom {
    color: #fff;           /* white default */
    background: none;
    border: none;
    text-decoration: none;
    display: block;
    padding: 10px 15px;
    width: 100%;
    text-align: left;
    font-family: var(--font-main);
}

.dropdown-item-custom:hover {
    color: var(--gold);
     background: #111;
}



.user-dropdown {
    position: relative;
    z-index: 2000;
    display: flex;
    align-items: center;
    height: 100%;
}

.dropdown-menu-custom {
    position: absolute;   /* Relative to parent */
    top: 100%;
    right: 0;
    background: #0a0a0a;  /* Dark background */
    border: none;
    min-width: 160px;
    z-index: 3000;
    box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    display: none;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.25s ease-in-out;
    visibility: hidden;
    pointer-events: none;

    display: none;
    opacity: 0;
    transform: translateY(10px);
   transition: all 0.25s ease-in-out;
   visibility: hidden;
    pointer-events: none;
}

.dropdown-menu-custom.show {
    display: block;
    opacity: 1;
    transform: translateY(0);
    visibility: visible;   
    pointer-events: auto;  
}

        @media (max-width: 768px) {
            .hero-content h1 { font-size: 2.5rem; }
            .search-container { display: none; }
            .col-6 { padding: 8px; }
        }
        @media (max-width: 991px) {
    .navbar-collapse {
        max-height: none !important;
        overflow: visible !important;
    }
}


@media (max-width: 768px) {
    .dropdown-menu-custom {
        right: 10px;
        left: auto;
    }
}

    </style>
</head>
