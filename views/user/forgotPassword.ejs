<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password | Royal Mist</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --gold: #c4a14d;
            --gold-light: #e2bd65;
            --gold-dark: #b59242;
            --dark-bg: #000000;
            --border-dim: #222;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background-color: var(--dark-bg);
            color: #fff;
            font-family: 'Montserrat', sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        /* ── Page wrapper ── */
        .page-wrapper {
            width: 100%;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 60px 20px;
        }

        /* ── Card container ── */
        .fp-container {
            width: 100%;
            max-width: 420px;
            animation: fadeUp 0.55s ease both;
        }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(22px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* ── Heading ── */
        .fp-title {
            font-family: 'Playfair Display', serif;
            font-size: 2.5rem;
            font-weight: 700;
            text-align: center;
            line-height: 1.15;
            margin-bottom: 18px;
            letter-spacing: -0.5px;
        }

        /* ── Description text (matches screenshot) ── */
        .fp-description {
            text-align: center;
            color: #888;
            font-size: 0.82rem;
            font-weight: 300;
            line-height: 1.75;
            letter-spacing: 0.3px;
            margin-bottom: 38px;
            padding: 0 10px;
        }

        /* ── Label ── */
        label {
            display: block;
            color: var(--gold);
            font-size: 0.7rem;
            letter-spacing: 2.5px;
            text-transform: uppercase;
            margin-bottom: 9px;
            font-weight: 500;
        }

        /* ── Input ── */
        .fp-input {
            width: 100%;
            background: transparent;
            border: 2px solid var(--border-dim);
            color: #fff;
            border-radius: 0;
            padding: 13px 14px;
            font-family: 'Montserrat', sans-serif;
            font-size: 0.88rem;
            font-weight: 300;
            outline: none;
            transition: border-color 0.25s;
            -webkit-appearance: none;
        }

        .fp-input:focus {
            border-color: var(--gold);
        }

        .fp-input::placeholder {
            color: #3a3a3a;
        }

        /* Autofill override */
        .fp-input:-webkit-autofill,
        .fp-input:-webkit-autofill:focus {
            -webkit-box-shadow: 0 0 0px 1000px #000 inset !important;
            -webkit-text-fill-color: #fff !important;
            transition: background-color 5000s ease-in-out 0s;
        }

        /* ── Error message ── */
        .field-error {
            color: #e05555;
            font-size: 0.72rem;
            letter-spacing: 0.5px;
            min-height: 20px;
            display: block;
            margin-top: 6px;
            margin-bottom: 4px;
        }

        /* ── Send OTP Button (Gold filled) ── */
        .btn-send-otp {
            width: 100%;
            background: linear-gradient(to right, var(--gold), var(--gold-dark));
            color: #000;
            border: none;
            padding: 15px;
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            cursor: pointer;
            transition: background 0.25s, transform 0.2s;
            margin-top: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            position: relative;
            overflow: hidden;
        }

        .btn-send-otp:hover:not(:disabled) {
            background: var(--gold-light);
            transform: translateY(-2px);
        }

        .btn-send-otp:active:not(:disabled) {
            transform: translateY(0);
        }

        .btn-send-otp:disabled {
            opacity: 0.55;
            cursor: not-allowed;
            transform: none;
        }

        /* Spinner inside button */
        .btn-spinner {
            width: 16px;
            height: 16px;
            border: 2px solid rgba(0,0,0,0.25);
            border-top-color: #000;
            border-radius: 50%;
            animation: spin 0.7s linear infinite;
            display: none;
        }

        @keyframes spin { to { transform: rotate(360deg); } }

        /* ── Back to Sign In Button (outline) ── */
        .btn-back {
            width: 100%;
            background: transparent;
            color: var(--gold);
            border: 2px solid var(--border-dim);
            padding: 15px;
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            cursor: pointer;
            transition: border-color 0.25s, background 0.25s;
            margin-top: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            text-decoration: none;
        }

        .btn-back:hover {
            border-color: var(--gold);
            background: rgba(196,161,77,0.05);
            color: var(--gold);
        }

        /* ── Toast ── */
        .toast-bar {
            display: none;
            position: fixed;
            top: 22px;
            left: 50%;
            transform: translateX(-50%);
            background: #000;
            color: var(--gold);
            border: 2px solid var(--gold);
            padding: 13px 26px;
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
            font-size: 0.8rem;
            letter-spacing: 1.5px;
            border-radius: 6px;
            z-index: 9999;
            white-space: nowrap;
            animation: slideDown 0.3s ease;
        }

        @keyframes slideDown {
            from { opacity: 0; top: 8px; }
            to   { opacity: 1; top: 22px; }
        }

        /* ── Mobile responsive ── */
        @media (max-width: 480px) {
            .page-wrapper { padding: 50px 24px; }
            .fp-container { max-width: 100%; }
            .fp-description { font-size: 0.8rem; padding: 0 4px; }
            .btn-send-otp, .btn-back { padding: 15px; font-size: 0.8rem; letter-spacing: 1.5px; }
        }

        @media (max-width: 360px) {
            .btn-send-otp, .btn-back { padding: 14px 12px; font-size: 0.72rem; }
        }
    </style>
</head>
<body>

<!-- Toast notification -->
<div class="toast-bar" id="toast"></div>

<div class="page-wrapper">
    <div class="fp-container">

        <!-- Title -->
        <h1 class="fp-title">Forgot<br>Password</h1>

        <!-- Description — exact copy from screenshot style -->
        <p class="fp-description">
            Please enter the email address associated with your<br>
            account and we will send you an OTP to reset your<br>
            password.
        </p>

        <!-- Form -->
        <form id="fpForm" novalidate>
            <label for="fp-email">Email Address</label>
            <input
                type="email"
                id="fp-email"
                name="email"
                class="fp-input"
                placeholder="vane@luxury.com"
                autocomplete="email"
            >
            <span class="field-error" id="email-error"></span>

            <button type="submit" class="btn-send-otp" id="sendBtn">
                <div class="btn-spinner" id="btnSpinner"></div>
                <span id="btnText">SEND OTP</span>
                <span id="btnArrow">→</span>
            </button>
        </form>

        <!-- Back link -->
        <a href="/signin" class="btn-back">
            ← BACK TO SIGN IN
        </a>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const form        = document.getElementById('fpForm');
    const emailInput  = document.getElementById('fp-email');
    const emailError  = document.getElementById('email-error');
    const sendBtn     = document.getElementById('sendBtn');
    const btnSpinner  = document.getElementById('btnSpinner');
    const btnText     = document.getElementById('btnText');
    const btnArrow    = document.getElementById('btnArrow');
    const toast       = document.getElementById('toast');

    // Clear error on typing
    emailInput.addEventListener('input', () => {
        emailError.textContent = '';
        emailInput.style.borderColor = '';
    });

    function showToast(msg) {
        toast.textContent = msg;
        toast.style.display = 'block';
        setTimeout(() => { toast.style.display = 'none'; }, 2800);
    }

    function setLoading(loading) {
        sendBtn.disabled = loading;
        btnSpinner.style.display = loading ? 'block' : 'none';
        btnText.textContent = loading ? 'SENDING...' : 'SEND OTP';
        btnArrow.style.display = loading ? 'none' : 'inline';
    }

    function validateEmail(email) {
        return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email);
    }

    form.addEventListener('submit', async (e) => {
        e.preventDefault();

        emailError.textContent = '';
        emailInput.style.borderColor = '';

        const email = emailInput.value.trim();

        // Client-side validation
        if (!email) {
            emailError.textContent = 'Please enter your email address.';
            emailInput.style.borderColor = '#e05555';
            emailInput.focus();
            return;
        }

        if (!validateEmail(email)) {
            emailError.textContent = 'Please enter a valid email address.';
            emailInput.style.borderColor = '#e05555';
            emailInput.focus();
            return;
        }

        setLoading(true);

        try {
            const res = await fetch('/forgot-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email }),
                credentials: 'include'
            });

            const data = await res.json();

            if (data.success) {
                showToast('OTP sent to ' + email);
                setTimeout(() => {
                    // Pass email via query param so OTP page can display it
                    window.location.href = '/verify-otp?email=' + encodeURIComponent(email);
                }, 1500);
            } else {
                // Handle backend errors
                if (data.errors && data.errors.email) {
                    emailError.textContent = data.errors.email;
                    emailInput.style.borderColor = '#e05555';
                } else {
                    emailError.textContent = data.message || 'Something went wrong. Please try again.';
                }
                setLoading(false);
            }

        } catch (err) {
            console.error(err);
            emailError.textContent = 'Network error. Please check your connection.';
            setLoading(false);
        }
    });
</script>
</body>
</html>
