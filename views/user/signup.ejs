<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account | Royal Mist</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root { 
            --gold: #c4a14d; 
            --solid-black: #000000; 
        }

        body { 
            background-color: var(--solid-black) !important; 
            color: #fff; 
            font-family: 'Montserrat', sans-serif; 
            padding: 50px 0;
        }

        h2 { font-family: 'Playfair Display', serif; font-size: 2.5rem; }
        
        .signup-wrapper { 
            max-width: 500px; 
            margin: 0 auto; 
            padding: 20px; 
        }

        label { 
            color: var(--gold); 
            font-size: 0.65rem; 
            letter-spacing: 3px; 
            text-transform: uppercase; 
            margin-bottom: 10px; 
            display: block; 
        }
        
        input { 
            background-color: var(--solid-black) !important; 
            border: 2px solid #222 !important; 
            color: #fff !important; 
            border-radius: 0 !important; 
            padding: 15px !important; 
            margin-bottom: 25px; 
        }

        input:focus { 
            border-color: var(--gold) !important; 
            box-shadow: none !important; 
        }

        /* Autofill / browser suggestion fix */
        input:-webkit-autofill {
            -webkit-box-shadow: 0 0 0px 1000px var(--solid-black) inset !important;
            -webkit-text-fill-color: #fff !important;
            transition: background-color 5000s ease-in-out 0s;
        }

        input:-webkit-autofill:focus {
            -webkit-box-shadow: 0 0 0px 1000px var(--solid-black) inset !important;
            -webkit-text-fill-color: #fff !important;
        }

        input:-moz-autofill {
            box-shadow: 0 0 0px 1000px var(--solid-black) inset !important;
            -moz-text-fill-color: #fff !important;
        }
        
        .btn-create { 
            background: linear-gradient(to right, #c4a14d, #b59242); 
            color: #000; 
            border: none; 
            width: 100%; 
            padding: 18px; 
            font-weight: 700; 
            text-transform: uppercase; 
            letter-spacing: 2px; 
            margin-top: 10px;
            transition: 0.3s;
        }

        .btn-create:hover { background: #e2bd65; transform: translateY(-2px); }

        .divider {
            display: flex;
            align-items: center;
            text-align: center;
            margin: 25px 0;
            color: #444;
            font-size: 0.7rem;
            letter-spacing: 2px;
        }

        .divider::before, .divider::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid #222;
        }

        .divider:not(:empty)::before { margin-right: .5em; }
        .divider:not(:empty)::after { margin-left: .5em; }

        .btn-google {
            background-color: transparent;
            color: #fff;
            border: 2px solid #222;
            width: 100%;
            padding: 15px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 0.8rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            transition: 0.3s;
        }

        .btn-google:hover {
            border-color: #fff;
            background: rgba(255, 255, 255, 0.05);
        }

        .google-icon { font-size: 1.1rem; }
        
        .footer-link { color: #555; font-size: 0.8rem; margin-top: 30px; text-align: center; }
        a { color: var(--gold); text-decoration: none; }
        .sub-text { color: #777; font-size: 0.85rem; margin-bottom: 40px; }


        
    </style>
</head>
<body>
<!-- Success Toast -->
<div id="successToast" style="
    display:none;
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: black;
    color:  #c4a14d;
    border: 2px solid #c4a14d;
    padding: 15px 25px;
    font-weight: 700;
    border-radius: 8px;
    font-family: 'Montserrat', sans-serif;
    z-index: 9999;
    align-items:center;
    gap:10px;
    box-shadow: 0 0 10px rgba(0,0,0,0.5);
">
    <span style="font-size:18px;">✅</span>
    <span id="successText">Account created successfully</span>
</div>
<div class="container signup-wrapper">
    <h2 class="text-center">Create Account</h2>
    <p class="text-center sub-text">Enter the world of luxury fragrances</p>

    <form id="signupForm" action="/signup" method="POST">
        <div class="row">
            <div class="col-6">
                <label>First Name</label>
                <input type="text" name="firstName" id="firstName" class="form-control" placeholder="firstname">
                  <p id = "firstName-error" style="color:red; font-size:12px; margin-top:-15px; margin-bottom:10px; display: none;"></p>
  
            </div>
            <div class="col-6">
                <label>Last Name</label>
                <input type="text" id="lastName" name="lastName" class="form-control" placeholder="lastname">
                  <p  id = "lastName-error" style="color:red; font-size:12px; margin-top:-15px; margin-bottom:10px; display: none;"></p>

            </div>
        </div>

       <label>Email Address</label>
<input type="text" name="email" id="email" class="form-control" placeholder="vane@luxury.com">
  <p id="email-error" style="color:red; font-size:12px; margin-top:-15px; margin-bottom:10px; display: none;"></p>

       <label>Phone Number</label>
<input type="tel" name="phoneNumber" id="phoneNumber" class="form-control" placeholder="9876543210" maxlength="10">
  <p id="phone-error" style="color:red; font-size:12px; margin-top:-15px; margin-bottom:10px; display: none;"></p>


        <label>Password</label>
       <div style="position: relative;">
  <input type="password" name="password" id="password" class="form-control">
  <button type="button" id="toggle-password" style="position: absolute; right: 15px; top: 50%; transform: translateY(-50%); background: none; border: none; color: #fff; cursor: pointer;">
      <i class="fa fa-eye"></i>
  </button>
</div>
          <p id="password-error" style="color:red; font-size:12px; margin-top:-15px; margin-bottom:10px; display: none;"></p>
        <p id="password-guide" style="font-size: 0.65rem; color: #444; margin-top: -20px; margin-bottom: 25px; position: relative; z-index: 0;">Must be at least 8 characters including a symbol.</p>
        <label>Confirm Password</label>
        <div style="position: relative;">
  <input type="password" name="confirmPassword" id="confirmPassword" class="form-control">
  <button type="button" id="toggle-confirm-password" style="position: absolute; right: 15px; top: 50%; transform: translateY(-50%); background: none; border: none; color: #fff; cursor: pointer; display:none;">
      <i class="fa fa-eye"></i>
  </button>
</div>
      <p id="confirmPassword-error" 
   style="color:red; font-size:12px; margin-top:-15px; margin-bottom:10px; display:none;">
</p>

        <label>Referral Code (Optional)</label>
        <input type="text" name="referralCode" class="form-control" placeholder="ROYAL-2024">

        <p class="text-center" style="font-size: 0.65rem; color: #444; margin: 20px 0;">BY JOINING, YOU AGREE TO OUR <a href="#">TERMS OF SERVICE</a> AND <a href="#">PRIVACY POLICY</a>.</p>

        <button type="submit" class="btn-create" id="createBtn">
          CREATE ACCOUNT →</button>
    </form>

    <div class="divider">OR SIGN UP WITH</div>

    <button type="button" class="btn-google" onclick="window.location.href='/auth/google'">
        <i class="fab fa-google google-icon"></i>
        SIGN UP WITH GOOGLE
    </button>

    <p class="footer-link">Already have an account? <a href="/signin">Sign in</a></p>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
  
const passwordInput = document.getElementById("password");
const togglePassword = document.getElementById("toggle-password");
const passwordError = document.getElementById("password-error");
const guideText = document.getElementById("password-guide");
const firstNameInput = document.getElementById("firstName");
const firstNameError = document.getElementById("firstName-error");
const lastNameInput = document.getElementById("lastName"); 
const lastNameError = document.getElementById("lastName-error")
const emailInput = document.getElementById("email");
const emailError = document.getElementById("email-error");

const confirmPasswordInput = document.getElementById("confirmPassword");
const toggleConfirmPassword = document.getElementById("toggle-confirm-password");
const confirmPasswordError = document.getElementById("confirmPassword-error");
const form = document.getElementById("signupForm");
 

// Function to show/hide eye toggle based on value or error
function updateToggle(inputField, toggleBtn, errorElement) {
  const value = inputField.value;
  if (value.length > 0 || (errorElement && errorElement.style.display === "block")) {
    toggleBtn.style.display = "block";
  } else {
    toggleBtn.style.display = "none";
    inputField.setAttribute("type", "password");
    toggleBtn.innerHTML = '<i class="fa fa-eye"></i>';
  }
}

// Initialize toggle visibility
updateToggle(passwordInput, togglePassword, passwordError);
updateToggle(confirmPasswordInput, toggleConfirmPassword, confirmPasswordError);

// Password input event
passwordInput.addEventListener("input", () => {
  updateToggle(passwordInput, togglePassword, passwordError);
  if (passwordError) passwordError.style.display = "none";
  guideText.style.display = passwordError.style.display === "none" ? "block" : "none";
});

// Confirm password input event
confirmPasswordInput.addEventListener("input", () => {
  updateToggle(confirmPasswordInput, toggleConfirmPassword, confirmPasswordError);
});

// Toggle password visibility
togglePassword.addEventListener("click", () => {
  const type = passwordInput.getAttribute("type") === "password" ? "text" : "password";
  passwordInput.setAttribute("type", type);
  togglePassword.innerHTML = type === "password" ? '<i class="fa fa-eye"></i>' : '<i class="fa fa-eye-slash"></i>';
});

// Toggle confirm password visibility
toggleConfirmPassword.addEventListener("click", () => {
  const type = confirmPasswordInput.getAttribute("type") === "password" ? "text" : "password";
  confirmPasswordInput.setAttribute("type", type);
  toggleConfirmPassword.innerHTML = type === "password" ? '<i class="fa fa-eye"></i>' : '<i class="fa fa-eye-slash"></i>';
});


const phoneInput = document.getElementById("phoneNumber");
let phoneError = document.getElementById("phone-error");

phoneInput.addEventListener("input", () => {
    phoneInput.value = phoneInput.value.replace(/\D/g, "");
    if (phoneInput.value.length > 10) {
        phoneInput.value = phoneInput.value.slice(0, 10);
    }
    if (phoneError) phoneError.style.display = "none";
});

phoneInput.addEventListener("blur", () => {
    const val = phoneInput.value;
    if (val.length > 0 && !/^[6-9]\d{9}$/.test(val)) {
        phoneError.innerText = "Valid 10-digit phone number required";
        phoneError.style.display = "block";
    }
});

firstNameInput.addEventListener("input", () => {
  firstNameInput.value = firstNameInput.value.replace(/\s/g, "");

  if (firstNameError) {
    firstNameError.style.display = "none";
  }
});
lastNameInput.addEventListener("input", () => {
  lastNameInput.value = lastNameInput.value.replace(/\s/g, "");

  if (lastNameError) {
    lastNameError.style.display = "none";
  }
});

emailInput.addEventListener("input", () => {
  emailInput.value = emailInput.value.replace(/\s/g, "");

  if (emailError) emailError.style.display = "none";
});

confirmPasswordInput.addEventListener("input", () => {
  if (confirmPasswordError) confirmPasswordError.style.display = "none";
});

let isSubmitting = false;
form.addEventListener("submit", async (e) => {
  e.preventDefault();
   if (isSubmitting) return; 
  isSubmitting = true;

   const btn = form.querySelector("button[type='submit']");
  //  btn.disabled = true;
  // btn.innerText = "Processing...";


  // clear old errors first 
  if (firstNameError) firstNameError.style.display = "none";
  if (emailError) emailError.style.display = "none";

  const formData = {
    firstName: firstNameInput.value.trim(),
    lastName: lastNameInput.value.trim(),
    email: emailInput.value.trim(),
    phoneNumber: phoneInput.value.trim(),
    password: passwordInput.value,
    confirmPassword: confirmPasswordInput.value
  };

  try {
    const res = await fetch("/signup", {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify(formData),
      credentials:"include"
    });

    const data = await res.json();

    if (data.success) {
    const toast = document.getElementById("successToast");
    const text = document.getElementById("successText");
    text.innerText = data.message || "Account created successfully";
    toast.style.display = "flex"; // show toast

    // hide after 2 seconds and redirect to signin
    setTimeout(() => {
        toast.style.display = "none";
        window.location.href = "/otp";
    }, 1200);
    } else {
      const errors = data.errors;

      if (errors.firstName) {
        firstNameError.innerText = errors.firstName;
        firstNameError.style.display = "block";
      }

      if (errors.lastName) {
        lastNameError.innerText = errors.lastName;
        lastNameError.style.display = "block";
      }

      if (errors.email) {
        emailError.innerText = errors.email;
        emailError.style.display = "block";
      }

      if (errors.phoneNumber) {
        phoneError.innerText = errors.phoneNumber;
        phoneError.style.display = "block";
      }

     if (errors.password) {
    passwordError.innerText = errors.password;
    passwordError.style.display = "block";
    guideText.style.display = "none";
}

      if (errors.confirmPassword) {
        confirmPasswordError.innerText = errors.confirmPassword;
        confirmPasswordError.style.display = "block";
      }
      // btn.disabled = false;
      // btn.innerText = "CREATE ACCOUNT →";
    }

  } catch (err) {
    console.log(err);
    btn.disabled = false;
  //    btn.innerText = "CREATE ACCOUNT →";
  //   text.innerText="something went wrong"
   }
   finally {
    isSubmitting = false;  
    btn.disabled = false;
  }
});


</script>
</body>
</html>