    <aside class="sidebar">
      <div class="card">
        <div class="card-title">Cart Summary</div>
        <div class="summary-rows">
          <div class="s-row"><span class="s-label">ITEM SUBTOTAL</span><span class="s-value" id="subtotalVal">₹6,200</span></div>
          <div class="s-row"><span class="s-label">SERVICE FEE</span><span class="s-value">₹0.00</span></div>
