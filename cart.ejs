      <div class="card">
        <div class="coupon-label">COUPON CODE</div>
        <input class="coupon-field" id="couponInput" type="text" placeholder="ENTER CODE (try ROYAL10)" />
        <div class="coupon-btns">
          <button class="btn-apply" onclick="applyCoupon()">APPLY</button>
          <button class="btn-cancel-c" onclick="cancelCoupon()">CANCEL</button>
        </div>
        <div class="coupon-msg" id="couponMsg"></div>
      </div>

      <p class="tos">By placing your order, you agree to the Royalmist <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>.</p>
