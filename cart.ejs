<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>ROYALMIST — Cart</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Public+Sans:wght@300;400;600;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --gold: #D4AF37; --gold-soft: #F1E5AC; --gold-dim: rgba(212,175,55,0.25); --gold-faint: rgba(212,175,55,0.08);
      --black: #000; --surface: #0c0c0c; --surface-2: #131313;
      --border: rgba(255,255,255,0.08); --border-gold: rgba(212,175,55,0.25);
      --white: #f1f5f9; --muted: #94a3b8; --dim: #64748b; --green: #4ade80; --red: #f87171;
      --serif: 'Playfair Display', Georgia, serif; --sans: 'Public Sans', system-ui, sans-serif;
      --px: clamp(16px, 5vw, 80px);
    }
    html { scroll-behavior: smooth; }
    body { background: var(--black); color: var(--white); font-family: var(--serif); min-height: 100vh; overflow-x: hidden; }
    a { text-decoration: none; } button { cursor: pointer; } input, button { font-family: inherit; }

    /* NAV */
    .nav { position: sticky; top: 0; z-index: 200; background: rgba(0,0,0,0.92); backdrop-filter: blur(14px); border-bottom: 1px solid var(--border-gold); }
    .nav-inner { display: flex; align-items: center; justify-content: space-between; padding: 0 var(--px); height: 64px; max-width: 1400px; margin: 0 auto; gap: 16px; }
    .nav-logo { display: flex; align-items: center; gap: 9px; flex-shrink: 0; }
    .nav-logo svg { width: 28px; height: 28px; flex-shrink: 0; }
    .nav-logo-text { font-family: var(--serif); font-size: clamp(15px, 2vw, 22px); color: var(--gold); letter-spacing: -.4px; white-space: nowrap; }
    .nav-links { display: flex; align-items: center; gap: clamp(20px, 3vw, 36px); }
    .nav-links a { font-family: var(--serif); font-size: 12px; color: var(--white); letter-spacing: 1.8px; transition: color .2s; white-space: nowrap; }
    .nav-links a:hover, .nav-links a.active { color: var(--gold); }
    .nav-search { display: flex; align-items: center; gap: 8px; border: 1px solid rgba(255,255,255,0.12); padding: 7px 12px; background: rgba(80,60,30,0.18); border-radius: 3px; flex: 0 1 210px; min-width: 0; }
    .nav-search svg { width: 15px; height: 15px; opacity: .4; flex-shrink: 0; }
    .nav-search input { background: none; border: none; outline: none; color: var(--white); font-family: var(--serif); font-size: 12px; width: 100%; min-width: 0; }
    .nav-search input::placeholder { color: var(--dim); }
    .nav-actions { display: flex; align-items: center; gap: 14px; flex-shrink: 0; }
    .nav-btn { background: none; border: none; color: var(--white); opacity: .75; transition: opacity .2s, color .2s; padding: 6px; position: relative; }
    .nav-btn:hover { opacity: 1; color: var(--gold); }
    .nav-btn svg { width: 20px; height: 20px; display: block; }
    .cart-badge { position: absolute; top: -2px; right: -2px; background: var(--gold); color: #000; font-family: var(--sans); font-size: 8px; font-weight: 700; width: 15px; height: 15px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
    .nav-hamburger { display: none; background: none; border: none; color: var(--white); padding: 6px; }
    .nav-hamburger svg { width: 22px; height: 22px; display: block; }
    .nav-drawer { display: none; flex-direction: column; background: rgba(0,0,0,0.97); border-bottom: 1px solid var(--border-gold); max-height: 0; overflow: hidden; transition: max-height .35s ease, padding .3s ease; }
    .nav-drawer.open { max-height: 340px; padding: 8px 0 20px; }
    .nav-drawer a { padding: 13px var(--px); font-family: var(--serif); font-size: 13px; color: var(--white); letter-spacing: 2px; border-bottom: 1px solid var(--border); transition: color .2s; display: block; }
    .nav-drawer a:hover { color: var(--gold); }
    .nav-drawer a:last-of-type { border-bottom: none; }
    .drawer-search { margin: 14px var(--px) 0; display: flex; align-items: center; gap: 8px; border: 1px solid rgba(255,255,255,0.12); padding: 10px 12px; background: rgba(80,60,30,0.18); }
    .drawer-search svg { width: 15px; height: 15px; opacity: .4; flex-shrink: 0; }
    .drawer-search input { background: none; border: none; outline: none; color: var(--white); font-family: var(--serif); font-size: 13px; width: 100%; }
    .drawer-search input::placeholder { color: var(--dim); }

    /* MAIN */
    main { padding: clamp(28px,5vw,56px) var(--px) clamp(60px,8vw,100px); max-width: 1400px; margin: 0 auto; }

    /* Breadcrumb */
    .breadcrumb { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-bottom: clamp(20px,3vw,36px); }
    .breadcrumb a { font-size: 9px; color: var(--white); letter-spacing: 2.5px; opacity: .5; transition: opacity .2s, color .2s; }
    .breadcrumb a:hover { opacity: 1; color: var(--gold); }
    .breadcrumb .sep { font-size: 9px; color: rgba(212,175,55,.4); letter-spacing: 2px; }
    .breadcrumb .crumb-active { font-size: 9px; color: var(--gold); letter-spacing: 2.5px; }

    /* Title */
    .page-title { text-align: center; margin-bottom: clamp(32px,5vw,60px); }
    .page-title h1 { font-size: clamp(28px,6vw,56px); font-weight: 500; letter-spacing: -1px; color: #fff; line-height: 1.1; }

    /* LAYOUT */
    .cart-layout { display: grid; grid-template-columns: 1fr 340px; gap: clamp(28px,4vw,64px); align-items: start; }

    /* Items header */
    .items-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
    .items-header h2 { font-family: var(--sans); font-size: 11px; letter-spacing: 2.5px; color: var(--muted); font-weight: 400; }
    .clear-all-btn { background: none; border: none; font-family: var(--sans); font-size: 10px; color: var(--dim); letter-spacing: 1px; text-decoration: underline; transition: color .2s; }
    .clear-all-btn:hover { color: var(--red); }

    /* Empty state */
    .cart-empty { padding: clamp(48px,8vw,96px) 0; text-align: center; display: none; }
    .cart-empty-icon { font-size: 48px; opacity: .2; margin-bottom: 20px; }
    .cart-empty p { color: var(--muted); font-size: 15px; margin-bottom: 28px; }
    .cart-empty a { display: inline-block; padding: 14px clamp(24px,4vw,40px); background: var(--gold); color: #000; font-family: var(--sans); font-weight: 700; font-size: 10px; letter-spacing: 3px; transition: opacity .2s; }
    .cart-empty a:hover { opacity: .85; }

    /* Cart item */
    .cart-item { display: grid; grid-template-columns: 96px 1fr; grid-template-rows: auto auto; column-gap: clamp(14px,2.5vw,28px); padding: clamp(18px,3vw,28px) 0; border-bottom: 1px solid var(--border); animation: fadeUp .35s ease both; transition: opacity .35s, transform .35s; }
    .cart-item.removing { opacity: 0; transform: translateX(-24px); }
    @keyframes fadeUp { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:none; } }

    .product-thumb { grid-row: 1/3; width: 96px; height: 120px; background: var(--surface-2); border: 1px solid var(--border-gold); display: flex; align-items: center; justify-content: center; overflow: hidden; align-self: start; flex-shrink: 0; }
    .thumb-emoji { font-size: 36px; opacity: .25; }

    .product-info { grid-column: 2; grid-row: 1; min-width: 0; padding-top: 2px; }
    .product-name { font-size: clamp(14px,2vw,19px); font-weight: 400; color: #fff; margin-bottom: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .product-meta { font-family: var(--sans); font-size: 10px; letter-spacing: 1.5px; color: var(--gold); margin-bottom: 5px; }
    .product-scent { font-family: var(--sans); font-size: 10px; color: var(--muted); opacity: .45; margin-bottom: clamp(8px,1.5vw,14px); }
    .btn-remove { background: none; border: none; font-family: var(--sans); font-size: 10px; color: var(--dim); letter-spacing: 1px; text-decoration: underline; padding: 0; transition: color .2s; }
    .btn-remove:hover { color: var(--red); }

    .item-bottom { grid-column: 2; grid-row: 2; display: flex; align-items: center; justify-content: space-between; padding-top: clamp(10px,2vw,18px); gap: 12px; flex-wrap: wrap; }

    .qty-control { display: inline-flex; align-items: center; border: 1px solid var(--border-gold); flex-shrink: 0; }
    .qty-btn { background: none; border: none; color: #fff; font-size: 15px; padding: 7px clamp(10px,1.5vw,14px); transition: background .2s, color .2s; line-height: 1; }
    .qty-btn:hover { background: var(--gold-faint); color: var(--gold); }
    .qty-display { padding: 7px clamp(10px,1.5vw,18px); font-size: 13px; color: #fff; border-left: 1px solid var(--border-gold); border-right: 1px solid var(--border-gold); min-width: 40px; text-align: center; font-family: var(--sans); }

    .item-price { font-size: clamp(15px,2vw,20px); color: #fff; white-space: nowrap; }

    /* SIDEBAR */
    .sidebar { display: flex; flex-direction: column; gap: 18px; position: sticky; top: 76px; }
    .card { background: var(--surface); border: 1px solid var(--border); padding: clamp(18px,3vw,28px); }
    .card-title { font-size: clamp(15px,2vw,18px); font-weight: 400; color: #fff; letter-spacing: .4px; margin-bottom: clamp(16px,2.5vw,24px); }
    .summary-rows { display: flex; flex-direction: column; gap: 13px; padding-bottom: 18px; border-bottom: 1px solid rgba(255,255,255,0.04); margin-bottom: 18px; }
    .s-row { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
    .s-label { font-family: var(--sans); font-size: 10px; color: var(--muted); letter-spacing: 1.5px; }
    .s-value { font-size: clamp(13px,1.5vw,16px); color: var(--gold-soft); white-space: nowrap; }
    .s-value.green { color: var(--green); }
    .total-row { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: clamp(18px,2.5vw,26px); gap: 8px; }
    .total-label { font-family: var(--sans); font-size: 12px; color: #fff; letter-spacing: 2px; }
    .total-value { font-size: clamp(20px,3vw,26px); color: var(--gold); }
    .btn-checkout { width: 100%; padding: clamp(14px,2vw,18px); background: var(--gold); border: none; color: #000; font-family: var(--sans); font-weight: 700; font-size: clamp(9px,1vw,11px); letter-spacing: 3.5px; transition: opacity .2s, transform .15s; }
    .btn-checkout:hover { opacity: .88; transform: translateY(-1px); }
    .btn-checkout:active { transform: translateY(0); }

    .coupon-label { font-family: var(--sans); font-size: 10px; color: var(--muted); letter-spacing: 1.5px; margin-bottom: 12px; }
    .coupon-field { width: 100%; border: 1px solid rgba(255,255,255,0.18); background: none; padding: 11px 13px; color: #fff; font-family: var(--sans); font-size: 11px; letter-spacing: 2px; outline: none; margin-bottom: 10px; transition: border-color .2s; }
    .coupon-field::placeholder { color: var(--dim); font-size: 10px; }
    .coupon-field:focus { border-color: var(--gold); }
    .coupon-btns { display: flex; gap: 10px; }
    .btn-apply { flex: 1; padding: 11px 6px; background: var(--gold); border: none; color: #000; font-family: var(--sans); font-weight: 700; font-size: 9px; letter-spacing: 1.5px; transition: opacity .2s; }
    .btn-apply:hover { opacity: .85; }
    .btn-cancel-c { flex: 1; padding: 11px 6px; background: none; border: 1px solid var(--gold); color: var(--gold); font-family: var(--sans); font-weight: 700; font-size: 9px; letter-spacing: 1.5px; transition: background .2s; }
    .btn-cancel-c:hover { background: var(--gold-faint); }
    .coupon-msg { font-family: var(--sans); font-size: 10px; margin-top: 9px; display: none; line-height: 1.5; }
    .coupon-msg.success { color: var(--green); display: block; }
    .coupon-msg.error { color: var(--red); display: block; }

    .tos { font-family: var(--sans); font-size: 9px; color: var(--dim); text-align: center; line-height: 1.9; padding: 0 4px; }
    .tos a { color: var(--dim); text-decoration: underline; transition: color .2s; }
    .tos a:hover { color: var(--gold); }

    /* MOBILE CHECKOUT BAR */
    .mobile-bar { display: none; position: fixed; bottom: 0; left: 0; right: 0; z-index: 150; background: rgba(0,0,0,0.95); border-top: 1px solid var(--border-gold); padding: 12px 16px; align-items: center; justify-content: space-between; gap: 14px; backdrop-filter: blur(12px); }
    .mobile-bar-info .lbl { font-family: var(--sans); font-size: 9px; color: var(--muted); letter-spacing: 1.5px; margin-bottom: 3px; }
    .mobile-bar-info .val { font-size: 20px; color: var(--gold); }
    .mobile-bar-btn { flex: 1; max-width: 200px; padding: 14px 10px; background: var(--gold); border: none; color: #000; font-family: var(--sans); font-weight: 700; font-size: 10px; letter-spacing: 3px; transition: opacity .2s; }
    .mobile-bar-btn:hover { opacity: .88; }

    /* TOAST */
    #toast { position: fixed; bottom: 24px; right: clamp(14px,4vw,32px); background: var(--surface-2); border: 1px solid var(--border-gold); color: #fff; padding: 12px 18px; font-family: var(--sans); font-size: 12px; letter-spacing: .3px; z-index: 9999; opacity: 0; transform: translateY(10px); transition: all .28s ease; pointer-events: none; max-width: calc(100vw - 32px); }
    #toast.show { opacity: 1; transform: none; }

    /* FOOTER */
    footer { border-top: 1px solid rgba(212,175,53,0.1); background: #080808; padding: clamp(36px,6vw,72px) var(--px) clamp(22px,4vw,36px); }
    .footer-grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: clamp(20px,4vw,48px); max-width: 1400px; margin: 0 auto; }
    .footer-brand-logo { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; }
    .footer-brand-logo svg { width: 20px; height: 20px; }
    .footer-brand-logo span { font-family: var(--serif); font-size: 16px; color: var(--gold); }
    .footer-brand p { font-size: 13px; color: var(--muted); line-height: 1.8; }
    .footer-col h4 { font-family: var(--serif); font-size: 11px; color: var(--gold); letter-spacing: 1.5px; margin-bottom: 14px; font-weight: 700; }
    .footer-col a, .footer-col p { display: block; font-size: 13px; color: var(--muted); line-height: 2.1; transition: color .2s; }
    .footer-col a:hover { color: var(--white); }
    .social-row { display: flex; gap: 14px; margin-bottom: 16px; }
    .social-row a { color: var(--muted); transition: color .2s; }
    .social-row a:hover { color: var(--gold); }
    .social-row svg { width: 18px; height: 18px; display: block; }
    .footer-copy { font-family: var(--sans); font-size: 11px; color: #b8970d; line-height: 1.7; }
    .footer-bottom { max-width: 1400px; margin: clamp(24px,4vw,36px) auto 0; padding-top: 18px; border-top: 1px solid var(--border); text-align: center; font-family: var(--sans); font-size: 10px; color: var(--dim); letter-spacing: 1px; }

    /* ── 1100px ── */
    @media (max-width: 1100px) {
      .cart-layout { grid-template-columns: 1fr 300px; }
      .nav-search { flex: 0 1 160px; }
    }

    /* ── 900px (tablet) ── */
    @media (max-width: 900px) {
      .nav-links, .nav-search { display: none; }
      .nav-hamburger { display: block; }
      .nav-drawer { display: flex; }
      .cart-layout { grid-template-columns: 1fr; }
      .sidebar { position: static; }
      .mobile-bar { display: flex; }
      main { padding-bottom: calc(clamp(60px,8vw,100px) + 72px); }
      .footer-grid { grid-template-columns: 1fr 1fr; }
    }

    /* ── 600px (phone) ── */
    @media (max-width: 600px) {
      :root { --px: 16px; }
      .nav-inner { height: 56px; gap: 8px; }
      .nav-btn svg { width: 19px; height: 19px; }
      .nav-actions { gap: 8px; }
      .footer-grid { grid-template-columns: 1fr; gap: 24px; }
      .page-title { margin-bottom: 24px; }
      .item-bottom { flex-direction: column; align-items: flex-start; gap: 10px; }
      .item-price { font-size: 16px; }
      .card { padding: 16px; }
      .coupon-btns { gap: 8px; }
    }

    /* ── 400px (small phone) ── */
    @media (max-width: 400px) {
      .nav-logo-text { display: none; }
      .cart-item { grid-template-columns: 74px 1fr; column-gap: 12px; }
      .product-thumb { width: 74px; height: 96px; }
      .thumb-emoji { font-size: 26px; }
      .qty-btn { padding: 7px 9px; font-size: 14px; }
      .qty-display { min-width: 34px; padding: 7px 9px; }
      .mobile-bar { flex-direction: column; align-items: stretch; gap: 8px; }
      .mobile-bar-btn { max-width: 100%; }
    }
  </style>
</head>
<body>

<!-- NAV -->
<nav class="nav">
  <div class="nav-inner">
    <a class="nav-logo" href="#">
      <svg viewBox="0 0 30 30" fill="none"><path d="M15 2L18.5 9.5L27 10.5L21 16.5L22.5 25L15 21L7.5 25L9 16.5L3 10.5L11.5 9.5L15 2Z" stroke="#D4AF37" stroke-width="1.4" fill="none"/></svg>
      <span class="nav-logo-text">ROYALMIST</span>
    </a>
    <nav class="nav-links">
      <a href="#">HOME</a><a href="#" class="active">SHOP</a><a href="#">ABOUT</a>
    </nav>
    <div class="nav-search">
      <svg fill="none" viewBox="0 0 24 24" stroke="#94a3b8" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
      <input type="text" placeholder="Search fragrances…" />
    </div>
    <div class="nav-actions">
      <button class="nav-btn" title="Wishlist"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg></button>
      <button class="nav-btn" title="Account"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg></button>
      <button class="nav-btn" title="Cart" onclick="document.querySelector('main').scrollIntoView({behavior:'smooth'})">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"/></svg>
        <span class="cart-badge" id="cartBadge">3</span>
      </button>
      <button class="nav-hamburger" onclick="toggleDrawer()" title="Menu">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" id="burgerIcon"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/></svg>
      </button>
    </div>
  </div>
  <div class="nav-drawer" id="navDrawer">
    <a href="#">HOME</a><a href="#">SHOP</a><a href="#">ABOUT</a>
    <div class="drawer-search">
      <svg fill="none" viewBox="0 0 24 24" stroke="#94a3b8" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
      <input type="text" placeholder="Search fragrances…" />
    </div>
  </div>
</nav>

<!-- MAIN -->
<main>
  <nav class="breadcrumb">
    <a href="#">HOME</a><span class="sep">/</span>
    <a href="#">SHOP</a><span class="sep">/</span>
    <span class="crumb-active">CART</span>
  </nav>

  <div class="page-title"><h1>Your Cart</h1></div>

  <div class="cart-layout">
    <!-- ITEMS -->
    <section>
      <div class="items-header">
        <h2 id="itemCount">3 ITEMS</h2>
        <button class="clear-all-btn" onclick="clearAll()">CLEAR ALL</button>
      </div>

      <div id="cartContainer">
        <div class="cart-item" data-id="1" data-price="2000">
          <div class="product-thumb"><div class="thumb-emoji">🌑</div></div>
          <div class="product-info">
            <div class="product-name">Midnight Oud</div>
            <div class="product-meta">MEN · 100ML</div>
            <div class="product-scent">Woody</div>
            <button class="btn-remove" onclick="removeItem(1)">REMOVE</button>
          </div>
          <div class="item-bottom">
            <div class="qty-control">
              <button class="qty-btn" onclick="changeQty(1,-1)">−</button>
              <div class="qty-display" id="qty-1">1</div>
              <button class="qty-btn" onclick="changeQty(1,+1)">+</button>
            </div>
            <div class="item-price" id="price-1">₹2,000</div>
          </div>
        </div>

        <div class="cart-item" data-id="2" data-price="1800">
          <div class="product-thumb"><div class="thumb-emoji">🌸</div></div>
          <div class="product-info">
            <div class="product-name">Rose Elixir</div>
            <div class="product-meta">WOMEN · 50ML</div>
            <div class="product-scent">Floral</div>
            <button class="btn-remove" onclick="removeItem(2)">REMOVE</button>
          </div>
          <div class="item-bottom">
            <div class="qty-control">
              <button class="qty-btn" onclick="changeQty(2,-1)">−</button>
              <div class="qty-display" id="qty-2">1</div>
              <button class="qty-btn" onclick="changeQty(2,+1)">+</button>
            </div>
            <div class="item-price" id="price-2">₹1,800</div>
          </div>
        </div>

        <div class="cart-item" data-id="3" data-price="2400">
